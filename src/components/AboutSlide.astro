---
import { about, links } from '../data/site';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<section class="slide" id="about">
  <div class="inner grid">
    <div class="rv side">
      <img class="photo" src={`${base}assets/personal/igor-portrait.jpg`} alt="Igor Gembitsky" loading="lazy" />
      <ul class="btns">
        <li><a class="btn primary" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a class="btn" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a class="btn" href={links.chess} target="_blank" rel="noopener noreferrer">Chess Match</a></li>
      </ul>
    </div>
    <div class="rv text" style="transition-delay:.12s">
      <p class="eyebrow eyebrow-accent">About</p>
      <h2>{about.headline}</h2>
      <p class="lead">{about.sub}</p>
      <ul class="bullets">{about.bullets.map((b) => <li>{b}</li>)}</ul>
      <p class="lead">{about.now}</p>
      <div class="science">
        <p class="lead">{about.science}</p>
        <ol class="method">{about.method.map((m) => <li>{m}</li>)}</ol>
        <a class="open" href={`${base}thinking/`}>More about how I think &rarr;</a>
      </div>
    </div>
  </div>
  <p class="foot">&copy; {year} Igor Gembitsky</p>
</section>



<style>
  .grid { display: grid; grid-template-columns: 300px 1fr; gap: 6vw; align-items: center; }
  .side { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; }
  .side .btns { flex-direction: column; width: 260px; }
  .side .btn { justify-content: center; width: 100%; }
  .photo { width: 260px; aspect-ratio: 1; border-radius: 50%; object-fit: cover; object-position: 50% 30%; display: block; }
  h2 { font-size: clamp(30px, 3.4vw, 46px); margin: 12px 0 18px; max-width: 18ch; }
  .lead { font-size: var(--fs-body); max-width: 36rem; }
  .muted { color: var(--color-muted); }
  .bullets { list-style: none; padding: 0; margin: 18px 0 18px; font-size: var(--fs-body); }
  .bullets li { padding: 4px 0 4px 22px; position: relative; }
  .bullets li::before { content: ""; position: absolute; left: 0; top: 0.95em; width: 10px; height: 1px; background: var(--color-accent); }
  .science { margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--color-rule); max-width: 36rem; }
  .method { list-style: decimal; margin: 10px 0 16px; padding-left: 24px; font-size: var(--fs-body); }
  .method li { padding: 2px 0; }
  .method li::marker { color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .foot { position: absolute; left: 6vw; bottom: 24px; font-size: var(--fs-small); color: var(--color-muted); }
  .papers { list-style: none; padding: 0; margin: 40px 0 0; max-width: 52rem; }
  .papers li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; padding: 22px 0; border-top: 1px solid var(--color-rule); }
  .papers .n { color: var(--color-accent); font-size: var(--fs-small); padding-top: 6px; }
  .papers a { font-size: clamp(18px, 1.6vw, 24px); line-height: 1.3; border-bottom: 1px solid var(--color-accent); }
  .papers a:hover { color: var(--color-accent); }
  .papers .meta { color: var(--color-muted); font-size: var(--fs-small); margin-top: 8px; }
  @media (max-width: 820px) { .slide { flex-direction: column; align-items: stretch; justify-content: center; } .grid { grid-template-columns: 1fr; gap: 28px; } .photo { width: 180px; } .foot { position: static; margin-top: 32px; } }
</style>
