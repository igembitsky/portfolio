---
import { about, links } from '../data/site';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<section class="slide" id="about">
  <div class="watermark" aria-hidden="true">Hi</div>
  <div class="inner grid">
    <div class="rv">
      <img class="me" src={`${base}assets/personal/igor.jpg`} alt="Igor Gembitsky" loading="lazy" />
    </div>
    <div class="rv" style="transition-delay:.12s">
      <p class="eyebrow eyebrow-accent">About</p>
      <h2>{about.headline}</h2>
      {about.paragraphs.map((p) => <p class="para">{p}</p>)}
      <ul class="cta">
        <li><a class="tlink" href={links.linkedin} target="_blank" rel="noopener noreferrer">Message me on LinkedIn &rarr;</a></li>
        <li><a class="tlink" href={links.github} target="_blank" rel="noopener noreferrer">GitHub &rarr;</a></li>
        <li><a class="tlink" href={links.chess} target="_blank" rel="noopener noreferrer">Play me at chess &rarr;</a></li>
      </ul>
      <p class="foot">&copy; {year} Igor Gembitsky &middot; Amsterdam, remote-first &middot; Built with Astro and Claude Code</p>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 300px 1fr; gap: 6vw; align-items: center; }
  .me { width: 100%; max-width: 300px; aspect-ratio: 1; border-radius: 50%; object-fit: cover; display: block; }
  h2 { font-size: clamp(32px, 4vw, 56px); margin: 14px 0 26px; }
  .para { max-width: 40rem; margin-bottom: 14px; }
  .cta { display: flex; gap: 28px; margin: 30px 0 0; list-style: none; padding: 0; font-size: 15px; flex-wrap: wrap; }
  .foot { margin-top: 48px; font-size: 13px; color: var(--color-muted); }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; gap: 28px; } .me { max-width: 160px; } }
</style>
