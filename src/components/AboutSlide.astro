---
import { about, links } from '../data/site';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<section class="slide" id="about">
  <div class="watermark" aria-hidden="true">Hi</div>
  <div class="inner grid">
    <div class="rv frame photo">
      <img src={`${base}assets/personal/igor-portrait.jpg`} alt="Igor Gembitsky" loading="lazy" />
    </div>
    <div class="rv" style="transition-delay:.12s">
      <p class="eyebrow eyebrow-accent">About</p>
      <h2>{about.headline}</h2>
      <p class="sub">{about.sub}</p>
      <ul class="bullets">{about.bullets.map((b) => <li>{b}</li>)}</ul>
      <p class="now">{about.now}</p>
      <div class="science">
        <p>{about.science}</p>
        <ol class="method">{about.method.map((m) => <li>{m}</li>)}</ol>
        <button type="button" class="tlink open" data-open="case-papers">View the papers &rarr;</button>
      </div>
      <ul class="cta">
        <li><a class="tlink" href={links.linkedin} target="_blank" rel="noopener noreferrer">Message me on LinkedIn &rarr;</a></li>
        <li><a class="tlink" href={links.github} target="_blank" rel="noopener noreferrer">GitHub &rarr;</a></li>
        <li><a class="tlink" href={links.chess} target="_blank" rel="noopener noreferrer">Play me at chess &rarr;</a></li>
      </ul>
      <p class="foot">&copy; {year} Igor Gembitsky &middot; Amsterdam, remote-first &middot; Built with Astro and Claude Code</p>
    </div>
  </div>
</section>

<dialog class="case" id="case-papers" aria-labelledby="case-papers-title">
  <button type="button" class="close" data-close>Close</button>
  <div class="wrap">
    <p class="eyebrow eyebrow-accent">Peer-reviewed research</p>
    <h2 id="case-papers-title">Three papers from the lab years</h2>
    <p class="thesis">Biochemistry and neuroscience, before product. The method carried over.</p>
    <ol class="papers">
      {about.papers.map((p, i) => (
        <li>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <a href={p.url} target="_blank" rel="noopener noreferrer">{p.title} &rarr;</a>
            <p class="meta">{p.journal} &middot; {p.date}</p>
          </div>
        </li>
      ))}
    </ol>
    <section class="sec">
      <h3>How it shapes the work</h3>
      <ul class="did">{about.method.map((m) => <li>{m}</li>)}</ul>
    </section>
  </div>
</dialog>

<style>
  .grid { display: grid; grid-template-columns: 320px 1fr; gap: 6vw; align-items: center; }
  .photo img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; display: block; }
  h2 { font-size: clamp(26px, 2.9vw, 40px); margin: 12px 0 14px; max-width: 22ch; }
  .sub { font-size: 18px; max-width: 36rem; }
  .bullets { list-style: none; padding: 0; margin: 22px 0 0; font-size: 17px; }
  .bullets li { padding: 4px 0 4px 22px; position: relative; }
  .bullets li::before { content: ""; position: absolute; left: 0; top: 0.95em; width: 10px; height: 1px; background: var(--color-accent); }
  .now { margin: 18px 0 0; color: var(--color-muted); font-size: 16px; max-width: 34rem; }
  .science { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--color-rule); font-size: 16px; max-width: 36rem; }
  .method { list-style: decimal; margin: 10px 0 14px; padding-left: 22px; color: var(--color-ink); }
  .method li { padding: 2px 0; }
  .method li::marker { color: var(--color-accent); font-variant-numeric: tabular-nums; }
  .open { background: none; border: 0; border-bottom: 1px solid var(--color-accent); font: inherit; font-size: 15px; color: var(--color-ink); cursor: pointer; padding: 0 0 2px; }
  .open:hover { color: var(--color-accent); }
  .cta { display: flex; gap: 28px; margin: 30px 0 0; list-style: none; padding: 0; font-size: 15px; flex-wrap: wrap; }
  .foot { margin-top: 28px; font-size: 13px; color: var(--color-muted); }
  .papers { list-style: none; padding: 0; margin: 40px 0 0; max-width: 52rem; }
  .papers li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; padding: 22px 0; border-top: 1px solid var(--color-rule); }
  .papers .n { color: var(--color-accent); font-size: 14px; padding-top: 6px; }
  .papers a { font-size: clamp(18px, 1.6vw, 24px); line-height: 1.3; border-bottom: 1px solid var(--color-accent); }
  .papers a:hover { color: var(--color-accent); }
  .papers .meta { color: var(--color-muted); font-size: 14px; margin-top: 8px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; gap: 28px; } .photo { max-width: 240px; } }
</style>
