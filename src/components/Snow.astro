---
// Blowing snow over the hero. Wind runs to the left, matching the hair in the photo.
// Builds while the hero is on screen. The pointer stirs it. Off under prefers-reduced-motion.
---
<canvas class="snow" aria-hidden="true"></canvas>

<style>
  .snow { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.snow');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduced) {
    const ctx = canvas.getContext('2d')!;
    const hero = canvas.parentElement as HTMLElement;
    let W = 0, H = 0, dpr = 1;
    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = hero.clientWidth; H = hero.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize(); addEventListener('resize', resize);

    // Soft flake sprites, pre-rendered at a few sizes: a bright core, a soft halo, a faint cool shadow so they read on bright sky
    const makeSprite = (r: number) => {
      const s = document.createElement('canvas'); const pad = r * 3; s.width = s.height = Math.ceil(pad * 2);
      const c = s.getContext('2d')!; const cx = pad, cy = pad;
      const halo = c.createRadialGradient(cx, cy, 0, cx, cy, r * 2.6);
      halo.addColorStop(0, 'rgba(30, 60, 70, 0.10)'); halo.addColorStop(1, 'rgba(30, 60, 70, 0)');
      c.fillStyle = halo; c.fillRect(0, 0, s.width, s.height);
      const core = c.createRadialGradient(cx - r * 0.15, cy - r * 0.15, 0, cx, cy, r);
      core.addColorStop(0, 'rgba(255,255,255,1)'); core.addColorStop(0.55, 'rgba(255,255,255,0.85)'); core.addColorStop(1, 'rgba(255,255,255,0)');
      c.fillStyle = core; c.beginPath(); c.arc(cx, cy, r, 0, Math.PI * 2); c.fill();
      return { img: s, half: pad };
    };
    const sprites = [0.9, 1.4, 2.0, 2.8, 3.8].map(makeSprite);

    type Flake = { x: number; y: number; z: number; vx: number; vy: number; s: number; a: number; ph: number; spin: number; k: number };
    const flakes: Flake[] = [];
    const MAX = 380;
    const spawn = (anywhere = false): Flake => {
      const z = Math.pow(Math.random(), 1.6);            // more far flakes than near ones
      return {
        x: anywhere ? Math.random() * W : W + Math.random() * 120,
        y: anywhere ? Math.random() * H : -40 + Math.random() * (H + 80),
        z, vx: 0, vy: 0,
        s: z < 0.25 ? 0 : z < 0.5 ? 1 : z < 0.75 ? 2 : z < 0.92 ? 3 : 4,
        a: 0.35 + z * 0.55,
        ph: Math.random() * Math.PI * 2,
        spin: 0.6 + Math.random() * 1.6,
        k: 0.5 + Math.random(),
      };
    };

    // Coherent wind field: layered sines act like slow eddies; the pointer adds a small vortex
    const field = (x: number, y: number, t: number, turb: number) => {
      const fx = Math.sin(y * 0.011 + t * 0.9) * 0.6 + Math.sin(y * 0.031 - t * 1.7 + x * 0.004) * 0.4;
      const fy = Math.sin(x * 0.013 + t * 0.7) * 0.5 + Math.cos(x * 0.029 + y * 0.017 - t * 1.3) * 0.5;
      return { x: fx * turb, y: fy * turb };
    };

    let px = -1e4, py = -1e4, pvx = 0, pvy = 0, lastPX = 0, lastPY = 0;
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const nx = e.clientX - r.left, ny = e.clientY - r.top;
      pvx = pvx * 0.6 + (nx - lastPX) * 0.4; pvy = pvy * 0.6 + (ny - lastPY) * 0.4;
      lastPX = nx; lastPY = ny; px = nx; py = ny;
    });
    hero.addEventListener('pointerleave', () => { px = -1e4; py = -1e4; pvx = pvy = 0; });

    let visible = false, onHero = 0, last = performance.now();
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; last = performance.now(); }, { threshold: 0.2 }).observe(hero);
    for (let i = 0; i < 24; i++) flakes.push(spawn(true));

    const frame = (now: number) => {
      requestAnimationFrame(frame);
      if (!visible || document.hidden) { last = now; return; }
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      onHero += dt;
      pvx *= 0.9; pvy *= 0.9;

      const build = Math.min(1, onHero / 55);
      const intensity = build * build * (3 - 2 * build);
      const target = Math.round(24 + intensity * (MAX - 24));
      while (flakes.length < target) flakes.push(spawn());

      // gust fronts: a slow base swell plus occasional sharper gusts
      const swell = 0.7 + 0.3 * Math.sin(onHero * 0.5) * Math.sin(onHero * 0.19 + 0.8);
      const gust = Math.max(0, Math.sin(onHero * 0.37 + 2.1)) ** 6 * 0.9;
      const wind = (55 + intensity * 300) * (swell + gust);       // px per second, to the left
      const turb = 10 + intensity * 55;
      const t = onHero;

      ctx.clearRect(0, 0, W, H);
      for (const f of flakes) {
        const depth = 0.25 + f.z * 1.1;
        const w = field(f.x, f.y, t, turb);
        const tx = -wind * depth + w.x * depth;
        const ty = (14 + f.z * 26) * f.k + w.y * depth * 0.7 + Math.sin(t * f.spin + f.ph) * (4 + 10 * f.z);
        const ease = Math.min(1, dt * (1.6 + f.z * 2.4));
        f.vx += (tx - f.vx) * ease; f.vy += (ty - f.vy) * ease;

        // pointer: a soft vortex plus a push along the pointer's motion
        const dx = f.x - px, dy = f.y - py, d2 = dx * dx + dy * dy, R = 150;
        if (d2 < R * R) {
          const d = Math.sqrt(d2) || 1, k = (1 - d / R) * (1 - d / R);
          f.vx += ((dx / d) * 260 + (-dy / d) * 180) * k * dt * depth + pvx * k * 14 * depth;
          f.vy += ((dy / d) * 260 + (dx / d) * 180) * k * dt * depth + pvy * k * 14 * depth;
        }

        f.x += f.vx * dt; f.y += f.vy * dt;
        if (f.x < -60 || f.y > H + 30 || f.y < -80) Object.assign(f, spawn());

        // twinkle: alpha breathes with the tumble
        const tw = 0.75 + 0.25 * Math.sin(t * f.spin * 1.3 + f.ph);
        const alpha = f.a * tw * (0.6 + 0.4 * intensity);
        const sp = sprites[f.s]; const speed = Math.hypot(f.vx, f.vy);

        if (f.z > 0.5 && speed > 160) {
          // near, fast flakes smear into a short streak along their motion, fading toward the tail
          const len = Math.min(34, speed * 0.055) * f.z;
          const ux = f.vx / speed, uy = f.vy / speed;
          const steps = 5;
          for (let i = 0; i < steps; i++) {
            const q = i / (steps - 1);
            ctx.globalAlpha = alpha * (1 - q * 0.85) * 0.7;
            ctx.drawImage(sp.img, f.x - ux * len * q - sp.half, f.y - uy * len * q - sp.half);
          }
        } else {
          ctx.globalAlpha = alpha;
          ctx.drawImage(sp.img, f.x - sp.half, f.y - sp.half);
        }
      }
      ctx.globalAlpha = 1;
    };
    requestAnimationFrame(frame);
  }
</script>
