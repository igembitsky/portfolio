---
import { hero, links, logos } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<section class="slide hero" id="top">
  <div class="bg" role="img" aria-label="Igor Gembitsky in front of a glacier lake" style={`background-image:url(${base}assets/personal/igor-hero.jpg)`}></div>
  <div class="veil"></div>
  <div class="copy">
    <p class="eyebrow eyebrow-accent">{hero.eyebrow}</p>
    <p class="domains">{hero.domains.join(' · ')}</p>
    <h1>{hero.headline}</h1>
    <p class="lede">{hero.paragraph}</p>
    <ul class="cta">
      <li><a class="tlink" href="#build-scale">Selected work &darr;</a></li>
      <li><a class="tlink" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn &rarr;</a></li>
      <li><a class="tlink" href={links.github} target="_blank" rel="noopener noreferrer">GitHub &rarr;</a></li>
      <li><a class="tlink" href={links.chess} target="_blank" rel="noopener noreferrer">Play me at chess &rarr;</a></li>
    </ul>
  </div>
  <div class="strip">
    <p class="eyebrow">Worked with</p>
    <ul class="logos">
      {logos.map((l) => (
        <li class={`lg-${l.key}`}>
          {l.file && <img src={`${base}assets/logos/brand/${l.file}`} alt={l.name} loading="eager" />}
          {l.mark && <span class="lockup"><img class="mark" src={`${base}assets/logos/brand/${l.mark}`} alt="" loading="eager" /><span class="name">{l.text}</span></span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { padding: 0; display: block; }
  .bg { position: absolute; inset: 0; background-position: center left; background-size: cover; background-repeat: no-repeat; }
  .veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(246,247,247,0) 38%, rgba(246,247,247,0.92) 64%, rgba(246,247,247,1) 100%); }
  .copy { position: relative; margin-left: auto; width: min(46rem, 50vw); padding: 22vh 6vw 0 0; min-height: calc(100svh - 150px); }
  .domains { font-size: 14px; color: var(--color-muted); margin: 12px 0 26px; letter-spacing: 0.02em; }
  h1 { font-size: clamp(32px, 4vw, 54px); }
  .lede { font-size: clamp(16px, 1.25vw, 19px); color: var(--color-muted); max-width: 34rem; margin: 26px 0 0; }
  .cta { display: flex; gap: 28px; margin: 36px 0 0; list-style: none; padding: 0; font-size: 15px; }
  .strip { position: relative; padding: 24px 6vw 28px; border-top: 1px solid var(--color-rule); background: linear-gradient(180deg, rgba(246,247,247,0.7), rgba(246,247,247,1)); }
  .strip .eyebrow { margin-bottom: 16px; }
  @media (max-width: 820px) {
    .veil { background: linear-gradient(180deg, rgba(246,247,247,0) 26%, rgba(246,247,247,0.95) 52%); }
    .copy { width: 100%; padding: 52vh 24px 40px; min-height: auto; }
    .bg { background-size: 140% auto; background-position: 34% 0; }
    .strip { padding: 20px 24px 28px; }
    .strip .logos { justify-content: flex-start; gap: 18px 28px; }
  }
</style>
