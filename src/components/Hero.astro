---
import { hero, logos } from '../data/site';
import Snow from './Snow.astro';
const base = import.meta.env.BASE_URL;
---
<section class="slide hero" id="top">
  <img class="bg" src={`${base}assets/personal/igor-hero.jpg`} alt="Igor Gembitsky in front of a glacier lake" width="1600" height="1200" fetchpriority="high" decoding="async" onload="this.classList.add('loaded')" />
  <div class="veil"></div>
  <Snow />
  <div class="copy">
    <p class="name">{hero.name}</p>
    <p class="role">{hero.eyebrow}</p>
    <h1>{hero.headline}</h1>
    <p class="domains">{hero.domains.map((line) => <span>{line.join('\u00a0· ')}</span>)}</p>
    <a class="seework" href="#build-scale">See the work &darr;</a>
  </div>
  <div class="strip">
    <div class="marquee" role="group" aria-label="Organizations I worked with" tabindex="0">
      <div class="track">
        {[0, 1, 2, 3].map((copy) => (
          <ul class="logos" aria-hidden={copy > 0 ? 'true' : undefined}>
            {logos.map((l) => (
              <li class={`lg-${l.key}`}>
                {l.file && <img src={`${base}assets/logos/brand/${l.file}`} alt={copy === 0 ? l.name : ''} loading="eager" />}
                {l.mark && <span class="lockup"><img class="mark" src={`${base}assets/logos/brand/${l.mark}`} alt="" loading="eager" /><span class="name">{l.text}</span></span>}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Phones only: drift the logo strip at 75 px/s. A touch, drag or wheel takes over with native momentum, and the
  // drift resumes 2 s after the strip comes to rest. Four copies of the list let it loop in both directions.
  const strip = document.querySelector<HTMLElement>('.hero .marquee');
  const phone = matchMedia('(max-width: 820px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  if (strip) {
    const SPEED = 75, RESUME = 2000, START = 2500;
    const copyW = () => strip.querySelector('.logos')?.getBoundingClientRect().width ?? 0;
    let pos = 0, last = 0, hold = performance.now() + START, touching = false, own = false, visible = true, raf = 0;
    const set = (x: number) => { own = true; strip.scrollLeft = x; };
    const pause = () => { hold = performance.now() + RESUME; };
    ['pointerdown', 'touchstart'].forEach((e) => strip.addEventListener(e, () => { touching = true; pause(); }, { passive: true }));
    ['pointerup', 'pointercancel', 'touchend', 'touchcancel'].forEach((e) => strip.addEventListener(e, () => { touching = false; pause(); }, { passive: true }));
    strip.addEventListener('wheel', pause, { passive: true });
    strip.addEventListener('scroll', () => { if (own) { own = false; return; } hold = Math.max(hold, performance.now() + RESUME); }, { passive: true });
    const tick = (t: number) => {
      raf = 0;
      if (!phone.matches || still.matches || !visible) return;
      const dt = Math.min(0.05, (t - (last || t)) / 1000); last = t;
      const w = copyW();
      if (w && !touching) {
        if (t > hold) {
          if (Math.abs(strip.scrollLeft - pos) > 2) pos = strip.scrollLeft;
          pos += SPEED * dt;
          if (pos >= w * 2) pos -= w;
          set(pos);
        } else if (t > hold - RESUME * 0.75) {
          // At rest after a swipe: jump by one copy if needed, which looks identical, so there is room both ways.
          let p = strip.scrollLeft;
          if (p < w * 0.5) p += w; else if (p > w * 2.5) p -= w;
          if (p !== strip.scrollLeft) set(p);
          pos = p;
        }
      }
      raf = requestAnimationFrame(tick);
    };
    const run = () => { if (!raf && phone.matches && !still.matches && visible) { last = 0; raf = requestAnimationFrame(tick); } };
    const reset = () => { if (phone.matches && !still.matches) { pos = copyW(); set(pos); } run(); };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; run(); }).observe(strip);
    phone.addEventListener('change', reset);
    still.addEventListener('change', run);
    if (document.readyState === 'complete') reset(); else addEventListener('load', reset);
  }
</script>

<style>
  .hero { padding: 0; display: block; }
  .bg { position: absolute; left: 0; top: 0; height: 100%; width: auto; max-width: none; display: block; -webkit-mask-image: linear-gradient(90deg, #000 78%, rgba(0,0,0,0.65) 92%, transparent 100%); mask-image: linear-gradient(90deg, #000 78%, rgba(0,0,0,0.65) 92%, transparent 100%); }
  .veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(246,247,247,0) 40%, rgba(246,247,247,0.7) 58%, rgba(246,247,247,0.95) 74%, rgba(246,247,247,1) 100%); -webkit-mask-image: linear-gradient(180deg, transparent 22%, rgba(0,0,0,0.6) 36%, #000 48%); mask-image: linear-gradient(180deg, transparent 22%, rgba(0,0,0,0.6) 36%, #000 48%); }
  .copy { position: relative; z-index: 2; isolation: isolate; margin-left: auto; width: min(42rem, 47vw); padding: min(30vh, max(96px, calc(78svh - 384px))) 6vw 22vh 0; }
  .copy > * { position: relative; }
  /* Entrance: the photo settles first, then the four lines arrive 90ms apart, then the logo strip. */
  :global(.js) .bg { opacity: 0; transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.js) .bg.loaded { opacity: 1; }
  :global(.js) .copy > *, :global(.js) .strip { opacity: 0; transform: translateY(12px); transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  :global(.js.ready) .copy > *, :global(.js.ready) .strip { opacity: 1; transform: none; }
  :global(.js.ready) .copy > :nth-child(1) { transition-delay: 0.1s; }
  :global(.js.ready) .copy > :nth-child(2) { transition-delay: 0.19s; }
  :global(.js.ready) .copy > :nth-child(3) { transition-delay: 0.28s; }
  :global(.js.ready) .copy > :nth-child(4) { transition-delay: 0.37s; }
  :global(.js.ready) .copy > :nth-child(5) { transition-delay: 0.46s; }
  :global(.js.ready) .strip { transition-delay: 0.5s; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .bg, :global(.js) .copy > *, :global(.js) .strip { opacity: 1; transform: none; transition: none; }
  }
  .copy .name { font-size: clamp(22px, 2vw, 28px); font-weight: 500; letter-spacing: -0.01em; }
  .role { color: #244b4f; font-size: var(--fs-label); letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; margin-top: 8px; }
  h1 { font-size: clamp(32px, 3.8vw, 52px); margin-top: 34px; max-width: 16ch; }
  .domains { margin: 26px 0 0; font-size: var(--fs-body); color: var(--color-ink); letter-spacing: 0.01em; }
  .domains span { display: block; }
  .seework { display: none; }
  /* Logo carousel: four copies of the list move left by one copy, then repeat, so very wide screens never show a blank end. It starts with Canary at the left. Hover or keyboard focus pauses it. */
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 28px, #000 calc(100% - 96px), transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 28px, #000 calc(100% - 96px), transparent 100%); }
  .track { display: flex; width: max-content; margin-left: 28px; animation: logo-marquee 70s linear 2.5s infinite; }
  .track:hover, .marquee:focus .track { animation-play-state: paused; }
  .marquee:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 6px; }
  @keyframes logo-marquee { from { transform: translateX(0); } to { transform: translateX(-25%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; scrollbar-width: none; }
    .marquee::-webkit-scrollbar { display: none; }
    .track { animation: none; }
    .track .logos[aria-hidden='true'] { display: none; }
  }
  .strip { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; padding: 64px calc(6vw - 28px) 30px; background: linear-gradient(180deg, rgba(246,247,247,0) 0%, rgba(246,247,247,0.85) 38%, rgba(246,247,247,0.97) 100%); }
  @media (max-width: 820px) {
    .bg { width: 100%; height: 62svh; object-fit: cover; object-position: 34% 0; -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%); mask-image: linear-gradient(180deg, #000 70%, transparent 100%); }
    .veil { background: linear-gradient(180deg, rgba(246,247,247,0) 26%, rgba(246,247,247,0.95) 52%); -webkit-mask-image: none; mask-image: none; }
    .copy { width: 100%; padding: 50vh 24px 28px; }
    h1 { margin-top: 24px; font-size: 30px; }
    .seework { display: inline-flex; align-items: center; min-height: 44px; margin-top: 22px; font-size: var(--fs-body); font-weight: 500; color: var(--color-accent); }
    .strip { position: static; padding: 8px 0 28px; background: none; }
    .track { margin-left: 24px; }
    /* Phones: the strip is a real horizontal scroller. The script below drifts it; a swipe takes over. */
    .marquee { overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain; }
    .marquee::-webkit-scrollbar { display: none; }
    .marquee .track { animation: none; }
    .domains { font-size: min(var(--fs-body), 4vw); }
    .domains span { white-space: nowrap; }
    .copy { padding-bottom: 20px; }
  }
</style>
