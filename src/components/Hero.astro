---
import { hero, logos } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<section class="slide hero" id="top">
  <img class="bg" src={`${base}assets/personal/igor-hero.jpg`} alt="Igor Gembitsky in front of a glacier lake" fetchpriority="high" />
  <div class="veil"></div>
  <div class="copy">
    <p class="name">{hero.name}</p>
    <p class="role">{hero.eyebrow}</p>
    <p class="domains">{hero.domains.join(' · ')}</p>
    <h1>{hero.headline}</h1>
  </div>
  <div class="strip">
    <ul class="logos">
      {logos.map((l) => (
        <li class={`lg-${l.key}`}>
          {l.file && <img src={`${base}assets/logos/brand/${l.file}`} alt={l.name} loading="eager" />}
          {l.mark && <span class="lockup"><img class="mark" src={`${base}assets/logos/brand/${l.mark}`} alt="" loading="eager" /><span class="name">{l.text}</span></span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { padding: 0; display: block; }
  .bg { position: absolute; left: 0; top: 0; height: 100%; width: auto; max-width: none; display: block; -webkit-mask-image: linear-gradient(90deg, #000 62%, rgba(0,0,0,0.55) 82%, transparent 100%); mask-image: linear-gradient(90deg, #000 62%, rgba(0,0,0,0.55) 82%, transparent 100%); }
  .veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(246,247,247,0) 44%, rgba(246,247,247,0.5) 62%, rgba(246,247,247,0.7) 100%); }
  .copy { position: relative; margin-left: auto; width: min(42rem, 47vw); padding: 30vh 6vw 22vh 0; }
  .copy .name { font-size: clamp(22px, 2vw, 28px); font-weight: 500; letter-spacing: -0.01em; }
  .role { color: var(--color-accent); font-size: 14px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; margin-top: 8px; }
  .domains { color: var(--color-muted); font-size: 15px; margin-top: 6px; letter-spacing: 0.02em; }
  h1 { font-size: clamp(32px, 3.8vw, 52px); margin-top: 40px; max-width: 16ch; }
  .strip { position: absolute; left: 0; right: 0; bottom: 0; padding: 64px 6vw 30px; background: linear-gradient(180deg, rgba(246,247,247,0) 0%, rgba(246,247,247,0.85) 38%, rgba(246,247,247,0.97) 100%); }
  @media (max-width: 820px) {
    .bg { width: 100%; height: 62svh; object-fit: cover; object-position: 34% 0; -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%); mask-image: linear-gradient(180deg, #000 70%, transparent 100%); }
    .veil { background: linear-gradient(180deg, rgba(246,247,247,0) 26%, rgba(246,247,247,0.95) 52%); }
    .copy { width: 100%; padding: 50vh 24px 28px; }
    h1 { margin-top: 24px; }
    .strip { position: static; padding: 8px 24px 28px; background: none; }
    .strip .logos { justify-content: flex-start; gap: 14px 22px; }
  }
</style>
