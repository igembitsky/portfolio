---
import { hero, logos } from '../data/site';
const base = import.meta.env.BASE_URL;
---
<section class="slide hero" id="top">
  <div class="bg" role="img" aria-label="Igor Gembitsky in front of a glacier lake" style={`background-image:url(${base}assets/personal/igor-hero.jpg)`}></div>
  <div class="veil"></div>
  <div class="copy">
    <h1>{hero.headline}</h1>
    <ul class="bullets">
      {hero.bullets.map((b) => <li>{b}</li>)}
    </ul>
    <p class="now">{hero.now}</p>
  </div>
  <div class="strip">
    <ul class="logos">
      {logos.map((l) => (
        <li class={`lg-${l.key}`}>
          {l.file && <img src={`${base}assets/logos/brand/${l.file}`} alt={l.name} loading="eager" />}
          {l.mark && <span class="lockup"><img class="mark" src={`${base}assets/logos/brand/${l.mark}`} alt="" loading="eager" /><span class="name">{l.text}</span></span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { padding: 0; display: block; }
  .bg { position: absolute; inset: 0; background-position: left center; background-size: auto 100%; background-repeat: no-repeat; -webkit-mask-image: linear-gradient(90deg, #000 55%, rgba(0,0,0,0.6) 75%, transparent 96%); mask-image: linear-gradient(90deg, #000 55%, rgba(0,0,0,0.6) 75%, transparent 96%); }
  .veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(246,247,247,0) 44%, rgba(246,247,247,0.5) 62%, rgba(246,247,247,0.7) 100%); }
  .copy { position: relative; margin-left: auto; width: min(44rem, 50vw); padding: 24vh 6vw 22vh 0; }
  h1 { font-size: clamp(32px, 4vw, 54px); }
  .bullets { list-style: none; padding: 0; margin: 30px 0 0; font-size: clamp(17px, 1.3vw, 20px); color: var(--color-ink); }
  .bullets li { padding: 6px 0 6px 22px; position: relative; }
  .bullets li::before { content: ""; position: absolute; left: 0; top: 0.95em; width: 10px; height: 1px; background: var(--color-accent); }
  .now { margin: 26px 0 0; color: var(--color-muted); font-size: clamp(15px, 1.15vw, 18px); max-width: 32rem; }
  .strip { position: absolute; left: 0; right: 0; bottom: 0; padding: 64px 6vw 30px; background: linear-gradient(180deg, rgba(246,247,247,0) 0%, rgba(246,247,247,0.85) 38%, rgba(246,247,247,0.97) 100%); }
  @media (max-width: 820px) {
    .bg { background-size: 140% auto; background-position: 34% 0; -webkit-mask-image: none; mask-image: none; }
    .veil { background: linear-gradient(180deg, rgba(246,247,247,0) 26%, rgba(246,247,247,0.95) 52%); }
    .copy { width: 100%; padding: 52vh 24px 180px; }
    .strip { padding: 40px 24px 24px; }
    .strip .logos { justify-content: flex-start; gap: 14px 22px; }
  }
</style>
