---
import { spotlight as f } from '../data/spotlight';
import Visual from './Visual.astro';
import Rich from './Rich.astro';
---
<section class="slide" id={f.id}>
  <div class="watermark" aria-hidden="true">{f.number}</div>
  <div class="inner grid">
    <div class="text rv">
      <p class="eyebrow eyebrow-accent">{f.number} &middot; {f.category}</p>
      <h2>{f.title}</h2>
      <p class="org">{f.org} &middot; {f.role}</p>
      <p class="note">{f.note}</p>
      <div class="score" role="table" aria-label="Impact scorecard">
        <div class="shead" role="row"><span class="stitle">Impact scorecard</span><span class="speriod">2017 to 2021</span></div>
        {f.compare.map((r) => (
          <div class="srow" role="row">
            <span class="slab" role="cell">{r.label}</span>
            <span class="sbefore" role="cell">{r.before}</span>
            <span class="sarrow" aria-hidden="true">&rarr;</span>
            <span class="safter" role="cell">{r.after}</span>
            <span class="sdelta" role="cell">{r.delta}</span>
          </div>
        ))}
      </div>
      <button type="button" class="tlink open" data-open={`case-${f.id}`}>View case study &rarr;</button>
    </div>
    <div class="media frame rv" style="transition-delay:.12s"><Visual v={f.visual} /></div>
  </div>
</section>

<dialog class="case spot" id={`case-${f.id}`} aria-labelledby={`case-${f.id}-title`}>
  <button type="button" class="close" data-close>Close</button>
  <div class="heroimg"><Visual v={f.hero} /></div>
  <div class="wrap">
    <p class="eyebrow eyebrow-accent">{f.org} &middot; {f.role} &middot; {f.note}</p>
    <h2 id={`case-${f.id}-title`} class="plain">{f.caseTitle}</h2>
    <blockquote class="quote"><p>{f.thesis}</p></blockquote>

    <section class="sec">
      <h3>The company</h3>
      <ul class="pts">{f.company.map((p) => <li><Rich text={p} /></li>)}</ul>
    </section>

    <section class="sec">
      <h3>The problem</h3>
      <ul class="pts">{f.problem.map((p) => <li><Rich text={p} /></li>)}</ul>
    </section>

    <section class="sec">
      <h3>Who it is for</h3>
      <p class="lead">The jewelry industry, in these roles:</p>
      <ul class="icp">{f.icp.map((i) => <li>{i}</li>)}</ul>
    </section>

    <section class="sec">
      <h3>What I did</h3>
      <ul class="pts">{f.did.map((d) => <li><Rich text={d} /></li>)}</ul>
    </section>

    <section class="sec">
      <h3>Building the team</h3>
      <ul class="pts">{f.team.map((d) => <li><Rich text={d} /></li>)}</ul>
    </section>

    <section class="sec">
      <h3>Impact</h3>
      <div class="impact6">
        {f.impact.map((m) => <div><b>{m.value}</b><span>{m.label}</span></div>)}
      </div>
    </section>

    <section class="sec">
      <h3>Gallery</h3>
      <div class="gallery">
        {f.gallery.map((v) => <div class="frame"><Visual v={v} /><p class="cap">{v.alt}</p></div>)}
      </div>
    </section>
  </div>
</dialog>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; align-items: center; }
  h2 { font-size: clamp(28px, 3vw, 40px); margin: 12px 0 10px; max-width: 20ch; }
  .org { font-size: 17px; }
  .domain { color: var(--color-muted); font-size: 16px; margin-top: 2px; }
  .note { color: var(--color-accent); font-size: 15px; font-weight: 500; margin-top: 4px; }
  .open { margin-top: 26px; background: none; border: 0; border-bottom: 1px solid var(--color-accent); font: inherit; font-size: 16px; color: var(--color-ink); cursor: pointer; padding: 0 0 2px; }
  .open:hover { color: var(--color-accent); }

  /* Scorecard */
  .score { margin-top: 26px; max-width: 42rem; border: 1px solid var(--color-rule); background: #fff; padding: 18px 22px 6px; }
  .shead { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; border-bottom: 1px solid var(--color-ink); }
  .stitle { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; }
  .speriod { font-size: 14px; color: var(--color-muted); }
  .srow { display: grid; grid-template-columns: 8.5rem 7.5rem 20px 1fr 8.5rem; gap: 10px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--color-rule); }
  .srow:last-child { border-bottom: 0; }
  .slab { font-size: 15px; color: var(--color-muted); }
  .sbefore { font-size: 16px; color: var(--color-muted); text-decoration: line-through; text-decoration-color: var(--color-rule); text-decoration-thickness: 1px; }
  .sarrow { color: var(--color-accent); font-size: 18px; text-align: center; }
  .safter { font-size: 18px; font-weight: 500; color: var(--color-ink); }
  .sdelta { font-size: 12.5px; font-weight: 500; color: var(--color-accent); background: rgba(47, 93, 98, 0.08); border-radius: 999px; padding: 4px 10px; white-space: nowrap; justify-self: end; }

  /* Case study */
  .heroimg { position: relative; width: 100%; height: 62svh; overflow: hidden; }
  .heroimg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%); mask-image: linear-gradient(180deg, #000 60%, transparent 100%); }
  .spot .wrap { padding-top: 0; margin-top: -4vh; position: relative; }
  .plain { font-size: 20px; font-weight: 400; margin: 10px 0 0; color: var(--color-muted); max-width: none; text-wrap: nowrap; }
  .quote { margin: 28px 0 8px; padding: 26px 32px; border-left: 3px solid var(--color-accent); background: rgba(47, 93, 98, 0.05); max-width: 40rem; }
  .quote p { font-size: clamp(26px, 2.6vw, 36px); font-weight: 300; line-height: 1.3; letter-spacing: -0.01em; margin: 0; }
  .lead { font-size: 18px; margin-bottom: 14px; }
  .pts { list-style: none; padding: 0; margin: 0; max-width: 46rem; }
  .pts li { position: relative; padding: 10px 0 10px 26px; font-size: 19px; line-height: 1.5; border-top: 1px solid var(--color-rule); }
  .pts li:first-child { border-top: 0; }
  .pts li::before { content: ""; position: absolute; left: 0; top: 1.35em; width: 12px; height: 1px; background: var(--color-accent); }
  .pts b { font-weight: 500; }
  .icp { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .icp li { border: 1px solid var(--color-rule); border-radius: 999px; padding: 10px 18px; font-size: 17px; }
  .impact6 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 32px; margin-top: 12px; }
  .impact6 div { border-top: 1px solid var(--color-rule); padding-top: 16px; }
  .impact6 b { display: block; font-weight: 300; font-size: clamp(36px, 3.8vw, 54px); line-height: 1.05; font-variant-numeric: tabular-nums; }
  .impact6 span { display: block; color: var(--color-muted); font-size: 17px; margin-top: 8px; max-width: 22ch; }
  .gallery { display: grid; gap: 28px; margin-top: 12px; }
  .gallery :global(img), .gallery :global(video) { width: 100%; display: block; }
  .cap { font-size: 15px; color: var(--color-muted); padding: 10px 14px; border-top: 1px solid var(--color-rule); margin: 0; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; gap: 28px; } .media { order: -1; }
    .impact6 { grid-template-columns: 1fr 1fr; }
    .srow { grid-template-columns: 1fr 1fr 18px 1.2fr; } .sdelta { display: none; }
    .heroimg { height: 40svh; } .spot .wrap { margin-top: 0; }
  }
</style>
