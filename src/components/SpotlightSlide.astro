---
import { spotlight as f } from '../data/spotlight';
import Visual from './Visual.astro';
import Rich from './Rich.astro';
---
<section class="slide" id={f.id}>
  <div class="watermark" aria-hidden="true">{f.number}</div>
  <div class="inner grid">
    <div class="head rv">
      <p class="eyebrow eyebrow-accent">{f.number}&nbsp;&middot; {f.category}</p>
      <h2>{f.title}</h2>
      <p class="card-org">{f.org}&nbsp;&middot; {f.role}</p>
      <p class="card-sub">{f.note}</p>
    </div>
    <div class="body rv" style="transition-delay:.08s">
      <div class="score" role="table" aria-label="Impact scorecard">
        <div class="shead"><span class="stitle">Impact scorecard</span><span class="speriod">2017 to 2021</span></div>
        <div class="scols" role="row"><span></span><span>Before</span><span></span><span class="after">After</span></div>
        {f.compare.map((r) => (
          <div class="srow" role="row">
            <span class="slab" role="cell">{r.label}</span>
            <span class="sbefore" role="cell">{r.before}</span>
            <span class="sarrow" aria-hidden="true">&rarr;</span>
            <span class="safter" role="cell">{r.after} {r.delta && <span class="sdelta">{r.delta}</span>}</span>
          </div>
        ))}
      </div>
      <button type="button" class="open" data-open={`case-${f.id}`}>View case study &rarr;</button>
    </div>
    <div class="media rv" style="transition-delay:.12s">
      <div class="collage">
        <div class="frame main on"><Visual v={f.shots[0]} /></div>
        <div class="side">{f.shots.slice(1).map((v) => <div class="frame"><Visual v={v} /></div>)}</div>
      </div>
      <div class="shotdots" aria-hidden="true">{f.shots.map((_, i) => <i class:list={{ on: i === 0 }}></i>)}</div>
    </div>
  </div>
</section>

<dialog class="case spot" id={`case-${f.id}`} aria-labelledby={`case-${f.id}-title`}>
  <button type="button" class="close" data-close aria-label="Close">Close</button>
  <div class="bar" aria-hidden="true">{f.org}</div>
  <div class="scroller" tabindex="-1">
  <div class="heroimg"><Visual v={f.hero} /></div>
  <div class="wrap" tabindex="-1">
    <p class="eyebrow eyebrow-accent"><span class="org">{f.org}&nbsp;&middot; </span>{f.role}&nbsp;&middot; {f.note}</p>
    <h2 id={`case-${f.id}-title`} class="plain">{f.caseTitle}</h2>
    <blockquote class="quote"><p>{f.thesis}</p></blockquote>

    <section class="sec">
      <h3>The company</h3>
      <ul class="pts">{f.company.map((p) => <li><Rich text={p} /></li>)}</ul>
    </section>

    <section class="sec">
      <h3>The problem</h3>
      <ul class="pts">{f.problem.map((p) => <li><Rich text={p} /></li>)}</ul>
    </section>

    <section class="sec">
      <h3>Who it is for</h3>
      <p class="lead">The jewelry industry, in these roles:</p>
      <ul class="icp">{f.icp.map((i) => <li>{i}</li>)}</ul>
    </section>

    <section class="sec">
      <h3>What I did</h3>
      <ul class="pts">{f.did.map((d) => <li><Rich text={d} /></li>)}</ul>
    </section>

    <section class="sec">
      <h3>Building the team</h3>
      <ul class="pts">{f.team.map((d) => <li><Rich text={d} /></li>)}</ul>
    </section>

    <section class="sec">
      <h3>Impact</h3>
      <div class="impact6">
        {f.impact.map((m) => <div><b>{m.value}</b><span>{m.label}</span></div>)}
      </div>
    </section>

    <section class="sec">
      <h3>Gallery</h3>
      <div class="gallery">
        {f.gallery.map((v) => <div class="frame"><Visual v={v} /><p class="cap">{v.alt}</p></div>)}
      </div>
    </section>
    <button type="button" class="btn back" data-close>Back to the work</button>
  </div>
  </div>
</dialog>

<script>
  // Phones: mark the screenshot nearest the center of the row, and light its dot.
  const row = document.querySelector<HTMLElement>('#build-scale .collage');
  const dots = document.querySelectorAll('#build-scale .shotdots i');
  if (row && dots.length) {
    const frames = [...row.querySelectorAll<HTMLElement>('.frame')];
    let queued = false;
    const mark = () => {
      queued = false;
      const r = row.getBoundingClientRect(), mid = r.left + r.width / 2;
      let best = 0, gap = Infinity;
      frames.forEach((f, i) => { const b = f.getBoundingClientRect(); const d = Math.abs(b.left + b.width / 2 - mid); if (d < gap) { gap = d; best = i; } });
      frames.forEach((f, i) => f.classList.toggle('on', i === best));
      dots.forEach((d, i) => d.classList.toggle('on', i === best));
    };
    row.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
  }
</script>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto; grid-template-areas: "head media" "body media"; gap: 0 5vw; align-items: end; }
  .head { grid-area: head; } .body { grid-area: body; } .media { grid-area: media; }
  .body { display: flex; flex-direction: column; }
  .body .open { align-self: flex-start; }
  .collage { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; }
  .collage :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .collage .main { aspect-ratio: 600 / 1298; max-height: 64svh; }
  .collage .side { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; }
  .collage .side .frame { min-height: 0; }
  h2 { font-size: clamp(28px, 3vw, 40px); margin: 12px 0 10px; max-width: 20ch; }
  .shotdots { display: none; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; grid-template-rows: auto; grid-template-areas: "head" "media" "body"; gap: 24px; align-items: start; }
    /* Phones: one large screenshot at a time, centered, neighbors peeking at both sides. The row runs edge to edge of the screen. */
    .media { min-width: 0; }
    .collage { --w: min(60vw, 300px); display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; margin-inline: -24px; padding-inline: calc((100% + 48px) / 2 - var(--w) / 2); }
    .collage::-webkit-scrollbar { display: none; }
    .collage .side { display: contents; }
    .collage .frame { flex: 0 0 var(--w); aspect-ratio: 600 / 1298; max-height: none; scroll-snap-align: center; scroll-snap-stop: always; transition: transform 0.25s, opacity 0.25s; }
    .collage .frame:not(.on) { transform: scale(0.92); opacity: 0.6; }
    .shotdots { display: flex; justify-content: center; gap: 6px; margin-top: 16px; }
    .shotdots i { width: 6px; height: 6px; border-radius: 3px; background: var(--color-rule); transition: background 0.2s, width 0.2s; }
    .shotdots i.on { width: 16px; background: var(--color-accent); }
  }
  @media (max-width: 820px) and (prefers-reduced-motion: reduce) { .collage .frame, .shotdots i { transition: none; } }
</style>
