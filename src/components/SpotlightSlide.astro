---
import { spotlight as f } from '../data/spotlight';
import Visual from './Visual.astro';
---
<section class="slide" id={f.id}>
  <div class="watermark" aria-hidden="true">{f.number}</div>
  <div class="inner grid">
    <div class="text rv">
      <p class="eyebrow eyebrow-accent">{f.number} &middot; {f.category}</p>
      <h2>{f.title}</h2>
      <p class="org">{f.org} &middot; {f.role}</p>
      <p class="summary">{f.summary}</p>
      <ul class="tags">{f.tags.map((t) => <li>{t}</li>)}</ul>
      <button type="button" class="tlink open" data-open={`case-${f.id}`}>View case study &rarr;</button>
    </div>
    <div class="media rv compare" style="transition-delay:.12s" role="table" aria-label="Before and after">
      <div class="head" role="row"><span></span><span class="col">Before</span><span class="col after">After</span></div>
      {f.compare.map((r) => (
        <div class="row" role="row">
          <span class="lab" role="cell">{r.label}</span>
          <span class="before" role="cell">{r.before}</span>
          <span class="after" role="cell">{r.after}</span>
        </div>
      ))}
      <p class="foot">First product hire, 2017 to 2021</p>
    </div>
  </div>
</section>

<dialog class="case spot" id={`case-${f.id}`} aria-labelledby={`case-${f.id}-title`}>
  <button type="button" class="close" data-close>Close</button>
  <div class="wrap">
    <div class="top">
      <div class="frame heroimg"><Visual v={f.hero} /></div>
      <div>
        <p class="eyebrow eyebrow-accent">{f.org} &middot; {f.role} &middot; {f.note}</p>
        <h2 id={`case-${f.id}-title`}>{f.caseTitle}</h2>
        <p class="thesis">{f.thesis}</p>
      </div>
    </div>

    <div class="cols">
      <section>
        <h3>The company</h3>
        {f.company.map((p) => <p>{p}</p>)}
      </section>
      <section>
        <h3>The problem</h3>
        {f.problem.map((p) => <p>{p}</p>)}
      </section>
    </div>

    <section class="sec">
      <h3>Who it is for</h3>
      <ul class="icp">{f.icp.map((i) => <li>{i}</li>)}</ul>
    </section>

    <section class="sec">
      <h3>What I did</h3>
      <ul class="did">{f.did.map((d) => <li>{d}</li>)}</ul>
    </section>

    <section class="sec">
      <h3>Building the team</h3>
      <ul class="did">{f.team.map((d) => <li>{d}</li>)}</ul>
    </section>

    <section class="sec">
      <h3>Impact</h3>
      <div class="impact6">
        {f.impact.map((m) => <div><b>{m.value}</b><span>{m.label}</span></div>)}
      </div>
    </section>

    <section class="sec">
      <h3>Gallery</h3>
      <div class="gallery">
        {f.gallery.map((v) => <div class="frame"><Visual v={v} /><p class="cap">{v.alt}</p></div>)}
      </div>
    </section>
  </div>
</dialog>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; align-items: center; }
  h2 { font-size: clamp(30px, 3.4vw, 46px); margin: 14px 0 10px; max-width: 18ch; }
  .org { color: var(--color-muted); font-size: 16px; letter-spacing: 0.02em; }
  .summary { margin: 22px 0 22px; max-width: 34rem; font-size: 17px; }
  .open { margin-top: 30px; background: none; border: 0; border-bottom: 1px solid var(--color-accent); font: inherit; font-size: 15px; color: var(--color-ink); cursor: pointer; padding: 0 0 2px; }
  .open:hover { color: var(--color-accent); }

  /* Before and after card */
  .compare { border: 1px solid var(--color-rule); background: #fff; padding: 28px 30px 22px; }
  .compare .head, .compare .row { display: grid; grid-template-columns: 1.1fr 1fr 1.3fr; gap: 20px; align-items: baseline; }
  .compare .head { padding-bottom: 12px; border-bottom: 1px solid var(--color-rule); }
  .compare .col { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-muted); font-weight: 500; }
  .compare .col.after { color: var(--color-accent); }
  .compare .row { padding: 16px 0; border-bottom: 1px solid var(--color-rule); }
  .compare .row:last-of-type { border-bottom: 0; }
  .compare .lab { color: var(--color-muted); font-size: 15px; }
  .compare .before { font-size: 17px; color: var(--color-muted); }
  .compare .after { font-size: clamp(18px, 1.5vw, 22px); font-weight: 500; color: var(--color-ink); }
  .compare .foot { margin: 14px 0 0; font-size: 14px; color: var(--color-muted); }

  /* Case study */
  .top { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; margin-top: 8px; }
  .heroimg :global(img) { width: 100%; display: block; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 56px; }
  .cols p { max-width: 34rem; margin-bottom: 12px; }
  .icp { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .icp li { border: 1px solid var(--color-rule); border-radius: 999px; padding: 8px 16px; font-size: 16px; }
  .impact6 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 32px; margin-top: 12px; }
  .impact6 div { border-top: 1px solid var(--color-rule); padding-top: 16px; }
  .impact6 b { display: block; font-weight: 300; font-size: clamp(34px, 3.6vw, 52px); line-height: 1.05; font-variant-numeric: tabular-nums; }
  .impact6 span { display: block; color: var(--color-muted); font-size: 16px; margin-top: 8px; max-width: 22ch; }
  .gallery { display: grid; gap: 28px; margin-top: 12px; }
  .gallery :global(img), .gallery :global(video) { width: 100%; display: block; }
  .cap { font-size: 14px; color: var(--color-muted); padding: 10px 14px; border-top: 1px solid var(--color-rule); margin: 0; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; gap: 28px; } .media { order: -1; }
    .top { grid-template-columns: 1fr; gap: 24px; } .cols { grid-template-columns: 1fr; gap: 28px; }
    .impact6 { grid-template-columns: 1fr 1fr; }
    .compare { padding: 20px; } .compare .head, .compare .row { grid-template-columns: 1fr 1fr 1.2fr; gap: 12px; }
  }
</style>
