---
// The customer lifecycle as a loop: five stages around a ring, feeding Product at the center.
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
const stages = [
  { name: 'Sales', outcome: 'Signed SOW' },
  { name: 'Implementation', outcome: 'Live customer' },
  { name: 'Adoption', outcome: 'App utilization' },
  { name: 'Use & Success', outcome: 'Business value' },
  { name: 'Relationship', outcome: 'Renewals and referrals' },
];
const cx = 300, cy = 240, r = 162;
const pts = stages.map((s, i) => {
  const a = (-90 + i * 72) * Math.PI / 180;
  return { ...s, x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
});
const mids = pts.map((p, i) => {
  const a = (-90 + i * 72 + 36) * Math.PI / 180;
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a), deg: a * 180 / Math.PI + 90 };
});
const labels = [
  { dx: 0, dy: -34, anchor: 'middle' },
  { dx: 22, dy: -6, anchor: 'start' },
  { dx: 16, dy: 34, anchor: 'start' },
  { dx: -16, dy: 34, anchor: 'end' },
  { dx: -22, dy: -6, anchor: 'end' },
];
---
<svg class:list={['loop', { detailed }]} viewBox="-30 0 660 484" role="img" aria-label="Customer lifecycle loop: Sales, Implementation, Adoption, Use and Success, Relationship, each feeding Product at the center">
  <circle cx={cx} cy={cy} r={r} class="ring" />
  {mids.map((m) => <polygon points="-5,-6 6,0 -5,6" transform={`translate(${m.x} ${m.y}) rotate(${m.deg})`} class="head" />)}
  {pts.map((p) => <line x1={p.x} y1={p.y} x2={cx + (p.x - cx) * 0.36} y2={cy + (p.y - cy) * 0.36} class="spoke" />)}
  <circle cx={cx} cy={cy} r="52" class="core" />
  <text x={cx} y={cy - 2} class="core-t">Product</text>
  <text x={cx} y={cy + 16} class="core-s">learns from every stage</text>
  {pts.map((p, i) => (
    <g>
      <circle cx={p.x} cy={p.y} r="7" class="node" />
      <text x={p.x + labels[i].dx} y={p.y + labels[i].dy} text-anchor={labels[i].anchor} class="name">{p.name}</text>
      <text x={p.x + labels[i].dx} y={p.y + labels[i].dy + 17} text-anchor={labels[i].anchor} class="out">{p.outcome}</text>
    </g>
  ))}
</svg>

<style>
  .loop { width: 100%; height: auto; display: block; font-family: inherit; }
  .ring { fill: none; stroke: var(--color-rule); stroke-width: 1.5; }
  .head { fill: var(--color-accent); }
  .spoke { stroke: var(--color-rule); stroke-width: 1; stroke-dasharray: 3 4; }
  .core { fill: rgba(47, 93, 98, 0.08); stroke: var(--color-accent); stroke-width: 1.2; }
  .core-t { font-size: 18px; font-weight: 500; fill: var(--color-ink); text-anchor: middle; }
  .core-s { font-size: 11px; fill: var(--color-muted); text-anchor: middle; }
  .node { fill: #fff; stroke: var(--color-accent); stroke-width: 2.5; }
  .name { font-size: 16px; font-weight: 500; fill: var(--color-ink); }
  .out { font-size: 13px; fill: var(--color-muted); }
</style>
