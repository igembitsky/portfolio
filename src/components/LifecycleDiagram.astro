---
// The customer lifecycle as a loop: five stages around a ring, feeding back into the whole journey.
interface Props { detailed?: boolean }
const { detailed = false } = Astro.props;
// Node colors from the VDB logo, used lightly.
const stages = [
  { name: 'Sales', outcome: ['Signed SOW'], color: '#3b72cc' },
  { name: 'Implementation', outcome: ['Live customer'], color: '#4ca191' },
  { name: 'Adoption', outcome: ['App utilization'], color: '#804195' },
  { name: 'Use & Success', outcome: ['Business value'], color: '#d31c50' },
  { name: 'Relationship', outcome: ['Renewals and', 'referrals'], color: '#713782' },
];
const cx = 300, cy = 250, r = 158;
const pts = stages.map((s, i) => {
  const a = (-90 + i * 72) * Math.PI / 180;
  return { ...s, x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
});
const mids = pts.map((p, i) => {
  const a = (-90 + i * 72 + 36) * Math.PI / 180;
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a), deg: a * 180 / Math.PI + 90 };
});
const labels = [
  { dx: 0, dy: -38, anchor: 'middle' },
  { dx: 24, dy: -8, anchor: 'start' },
  { dx: 18, dy: 36, anchor: 'start' },
  { dx: -18, dy: 36, anchor: 'end' },
  { dx: -24, dy: -8, anchor: 'end' },
];
---
<svg class:list={['loop', { detailed }]} viewBox="-20 0 640 510" role="img" aria-label="Customer lifecycle loop: Sales, Implementation, Adoption, Use and Success, Relationship, each feeding back into the whole journey">
  <circle cx={cx} cy={cy} r={r} class="ring" />
  {mids.map((m) => <polygon points="-5,-6 6,0 -5,6" transform={`translate(${m.x} ${m.y}) rotate(${m.deg})`} class="head" />)}
  {pts.map((p) => <line x1={p.x} y1={p.y} x2={cx + (p.x - cx) * 0.4} y2={cy + (p.y - cy) * 0.4} class="spoke" style={`stroke:${p.color}`} />)}
  <circle cx={cx} cy={cy} r="58" class="core" />
  <text x={cx} y={cy - 6} class="core-t">Customer</text>
  <text x={cx} y={cy + 16} class="core-t">lifecycle</text>
  {pts.map((p, i) => (
    <g>
      <circle cx={p.x} cy={p.y} r="8" class="node" style={`stroke:${p.color}`} />
      <text x={p.x + labels[i].dx} y={p.y + labels[i].dy} text-anchor={labels[i].anchor} class="name">{p.name}</text>
      {p.outcome.map((line, k) => (
        <text x={p.x + labels[i].dx} y={p.y + labels[i].dy + 21 + k * 18} text-anchor={labels[i].anchor} class="out">{line}</text>
      ))}
    </g>
  ))}
</svg>

<style>
  .loop { width: 100%; height: auto; display: block; font-family: inherit; }
  .ring { fill: none; stroke: var(--color-rule); stroke-width: 1.5; }
  .head { fill: var(--color-muted); opacity: 0.8; }
  .spoke { stroke-width: 1.2; stroke-dasharray: 3 4; opacity: 0.45; }
  .core { fill: #fff; stroke: var(--color-rule); stroke-width: 1.5; }
  .core-t { font-size: 19px; font-weight: 500; fill: var(--color-ink); text-anchor: middle; }
  .node { fill: #fff; stroke-width: 3; }
  .name { font-size: 20px; font-weight: 500; fill: var(--color-ink); }
  .out { font-size: 15px; fill: var(--color-muted); }
</style>
