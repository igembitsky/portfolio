---
import { others } from '../data/site';
import Visual from './Visual.astro';
---
<section class="slide" id="other">
  <div class="watermark" aria-hidden="true">05</div>
  <div class="inner">
    <div class="head rv">
      <p class="eyebrow eyebrow-accent">05 &middot; Earlier work</p>
      <h2>Some other things I've built</h2>
    </div>
    <div class="rows">
      {others.map((o, i) => (
        <article class="row rv" style={`transition-delay:${0.08 * (i + 1)}s`}>
          <div class="frame media"><Visual v={o.visual} /></div>
          <div class="body">
            <h3>{o.name}</h3>
            <p class="tag">{o.tagline}</p>
            <p class="desc">{o.description}</p>
            {o.role && <p class="desc">{o.role}</p>}
            <ul class="tags">{o.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="results">
            {o.results.map((r) => <div><b>{r.value}</b><span>{r.label}</span></div>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { font-size: clamp(28px, 3vw, 40px); margin: 14px 0 0; }
  .rows { margin-top: 36px; }
  .row { display: grid; grid-template-columns: 240px 1fr 200px; gap: 36px; align-items: center; padding: 26px 0; border-top: 1px solid var(--color-rule); }
  .row:last-child { border-bottom: 1px solid var(--color-rule); }
  .media :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center; display: block; }
  h3 { font-size: 24px; font-weight: 400; margin: 0 0 4px; }
  .tag { color: var(--color-muted); font-size: var(--fs-body); }
  .desc { margin: 10px 0 0; font-size: var(--fs-small); max-width: 46rem; }
  .tags { margin: 12px 0 0; }
  .results { display: grid; gap: 14px; }
  .results b { display: block; font-weight: 300; font-size: 26px; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .results span { display: block; color: var(--color-muted); font-size: var(--fs-small); margin-top: 2px; }
  @media (max-width: 1000px) { .row { grid-template-columns: 1fr; gap: 20px; } .results { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 820px) {
    .rows { margin-top: 28px; }
    .row { gap: 18px; padding: 28px 0; }
    .media :global(img) { aspect-ratio: 16 / 10; max-height: 42svh; }
    h3 { font-size: 22px; }
    .desc { font-size: var(--fs-body); color: var(--color-muted); }
    .tag + .desc { color: var(--color-ink); }
    .results { gap: 12px; }
    .results b { font-size: 24px; }
    .results span { font-size: var(--fs-label); }
  }
</style>
