---
import { others } from '../data/site';
import Visual from './Visual.astro';
---
<section class="slide" id="other">
  <div class="inner">
    <div class="head rv">
      <p class="eyebrow eyebrow-accent">Other things I've built</p>
      <h2>Range beyond the flagship work.</h2>
    </div>
    <div class="cards">
      {others.map((o, i) => (
        <article class="card rv" style={`transition-delay:${0.08 * (i + 1)}s`}>
          <Visual v={o.visual} class="shot" />
          <div class="body">
            <h3>{o.name}</h3>
            <p class="tag">{o.tagline}</p>
            <p class="desc">{o.description}</p>
            {o.role && <p class="desc">{o.role}</p>}
            <ul class="tags">{o.tags.map((t) => <li>{t}</li>)}</ul>
            <div class="results">
              {o.results.map((r) => <div><b>{r.value}</b><span>{r.label}</span></div>)}
            </div>
            {o.resultsNote && <p class="note">{o.resultsNote}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { font-size: clamp(28px, 3vw, 40px); margin: 14px 0 0; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 40px; }
  .card { display: grid; grid-template-columns: 250px 1fr; gap: 24px; align-items: start; }
  .card :global(img), .card :global(.ph) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center; border: 1px solid var(--color-rule); display: block; }
  h3 { font-size: 22px; font-weight: 400; margin: 0 0 4px; }
  .tag { color: var(--color-muted); font-size: 15px; }
  .desc { margin: 10px 0 0; font-size: 14px; }
  .tags { margin: 12px 0 14px; font-size: 13px; }
  .results { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; border-top: 1px solid var(--color-rule); padding-top: 12px; }
  .results b { display: block; font-weight: 300; font-size: 24px; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .results span { display: block; color: var(--color-muted); font-size: 12px; margin-top: 4px; }
  .note { font-size: 12px; color: var(--color-muted); margin-top: 8px; }
  @media (max-width: 1000px) { .cards { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .card { grid-template-columns: 1fr; } }
</style>
