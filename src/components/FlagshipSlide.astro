---
import type { Flagship } from '../data/site';
import Visual from './Visual.astro';
import Diagram from './Diagram.astro';
import LifecycleDiagram from './LifecycleDiagram.astro';
interface Props { f: Flagship }
const { f } = Astro.props;
---
<section class="slide" id={f.id}>
  <div class="watermark" aria-hidden="true">{f.number}</div>
  <div class="inner grid">
    <div class="text rv">
      <p class="eyebrow eyebrow-accent">{f.number} &middot; {f.category}</p>
      <h2>{f.title}</h2>
      <p class="org">{f.org}</p>
      <p class="summary">{f.summary}</p>
      <ul class="tags">{f.tags.map((t) => <li>{t}</li>)}</ul>
      <button type="button" class="tlink open" data-open={`case-${f.id}`}>View case study &rarr;</button>
    </div>
    <div class="media frame rv" style="transition-delay:.12s">
      {f.diagram === 'system' ? <div class="diagram-box"><LifecycleDiagram /></div> : <Visual v={f.key} />}
    </div>
  </div>
</section>

<dialog class="case" id={`case-${f.id}`} aria-labelledby={`case-${f.id}-title`}>
  <button type="button" class="close" data-close aria-label="Close">Close</button>
  <div class="wrap" tabindex="-1">
    <p class="eyebrow eyebrow-accent">{f.number} &middot; {f.category} &middot; {f.org}</p>
    <h2 id={`case-${f.id}-title`}>{f.title}</h2>
    <p class="thesis">{f.summary}</p>
    {f.diagram === 'system' ? <div class="visual frame diagram-wide"><LifecycleDiagram detailed /></div> : <div class="visual frame"><Visual v={f.key} wide /></div>}
    <div class="cols">
      <section><h3>Goal</h3><p>{f.goal}</p></section>
      <section><h3>Users</h3><p>{f.users}</p></section>
    </div>
    <section class="sec">
      <h3>What I did</h3>
      <ul class="did">{f.did.map((d) => <li>{d}</li>)}</ul>
    </section>
    <section class="sec">
      <h3>Impact</h3>
      <div class="impact">
        {f.impact.map((m) => <div><b>{m.value}</b><span>{m.label}</span></div>)}
      </div>
    </section>
    {f.diagram === 'platform' && <div class="sec"><Diagram kind="platform" /></div>}
    {f.support.length > 0 && (
      <div class="support">
        {f.support.map((v) => <div class="frame"><Visual v={v} /></div>)}
      </div>
    )}
  </div>
</dialog>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 6vw; align-items: center; }
  h2 { font-size: clamp(30px, 3.4vw, 46px); margin: 14px 0 10px; max-width: 18ch; }
  .org { color: var(--color-muted); font-size: 15px; letter-spacing: 0.04em; }
  .summary { margin: 22px 0 22px; max-width: 34rem; font-size: 17px; }
  .open { margin-top: 30px; background: none; border: 0; border-bottom: 1px solid var(--color-accent); font: inherit; font-size: 15px; color: var(--color-ink); cursor: pointer; padding: 0 0 2px; }
  .open:hover { color: var(--color-accent); }
  .diagram-box { width: 100%; aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; padding: 4%; }
  .diagram-wide { padding: 32px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; gap: 28px; } .media { order: -1; } }
</style>
