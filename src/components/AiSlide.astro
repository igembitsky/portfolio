---
import { ai } from '../data/site';
import Visual from './Visual.astro';
import Rich from './Rich.astro';
---
<section class="slide" id="build-ai">
  <div class="watermark" aria-hidden="true">{ai.number}</div>
  <div class="inner">
    <div class="head rv">
      <p class="eyebrow eyebrow-accent">{ai.number} &middot; {ai.category} &middot; {ai.org}</p>
      <h2>{ai.title}</h2>
    </div>
    <div class="cards">
      {ai.products.map((p, i) => (
        <article class="card rv" style={`transition-delay:${0.08 * (i + 1)}s`}>
          <div class="frame"><Visual v={p.visual} /></div>
          <h3>{p.name}</h3>
          <p class="tag">{p.tagline}</p>
          <p class="desc"><Rich text={p.description} /></p>
          <div class="foot">
            <span class="status">{p.status}</span>
            <span class="links">{p.links.map((l) => <a class="tlink" href={l.url} target="_blank" rel="noopener noreferrer">{l.label} &rarr;</a>)}</span>
          </div>
        </article>
      ))}
    </div>
    <div class="cdots" aria-hidden="true">{ai.products.map(() => <span></span>)}</div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>("#build-ai .cards");
  const dots = document.querySelectorAll<HTMLElement>("#build-ai .cdots span");
  if (track && dots.length) {
    const paint = () => {
      const card = track.firstElementChild as HTMLElement | null; if (!card) return;
      const step = card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || "16");
      const i = Math.min(dots.length - 1, Math.max(0, Math.round(track.scrollLeft / step)));
      dots.forEach((d, k) => d.classList.toggle("on", k === i));
    };
    paint(); track.addEventListener("scroll", paint, { passive: true });
  }
</script>

<style>
  h2 { font-size: clamp(30px, 3.4vw, 46px); margin: 14px 0 0; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: auto auto auto auto auto; gap: 0 24px; margin-top: 36px; }
  .card { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; border: 1px solid var(--color-rule); background: #fff; }
  .card > .frame { border: 0; border-bottom: 1px solid var(--color-rule); }
  .card :global(img), .card :global(.ph) { aspect-ratio: 16 / 10; }
  h3 { font-size: 24px; font-weight: 500; margin: 26px 26px 0; }
  .tag { font-size: var(--fs-body); font-weight: 500; margin: 10px 26px 0; line-height: 1.4; }
  .desc { margin: 16px 26px 0; font-size: var(--fs-body); color: var(--color-muted); }
  .desc :global(a) { color: var(--color-ink); }
  .foot { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin: 26px 0 0; padding: 16px 26px 20px; border-top: 1px solid var(--color-rule); font-size: var(--fs-small); color: var(--color-muted); }
  .links { display: flex; gap: 16px; white-space: nowrap; color: var(--color-ink); }
  .cdots { display: none; }
  /* Phones: one card at a time, swipe sideways, next card peeks in from the right */
  @media (max-width: 900px) {
    .cards { display: flex; gap: 16px; margin: 28px -24px 0; padding: 0 24px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 24px; -webkit-overflow-scrolling: touch; scrollbar-width: none; align-items: stretch; }
    .cards::-webkit-scrollbar { display: none; }
    .card { flex: 0 0 84vw; max-width: 21rem; grid-row: auto; grid-template-rows: auto auto auto 1fr auto; scroll-snap-align: start; }
    h3 { font-size: 22px; margin: 20px 20px 0; }
    .tag { margin: 8px 20px 0; }
    .desc { margin: 12px 20px 0; font-size: var(--fs-small); }
    .foot { margin-top: 20px; padding: 14px 20px 16px; }
    .cdots { display: flex; justify-content: center; gap: 10px; margin-top: 24px; }
    .cdots span { width: 8px; height: 8px; border-radius: 50%; background: var(--color-rule); transition: background 0.2s, transform 0.2s; }
    .cdots span.on { background: var(--color-accent); transform: scale(1.25); }
  }
</style>
