---
import { ai } from '../data/site';
import Visual from './Visual.astro';
---
<section class="slide" id="build-ai">
  <div class="watermark" aria-hidden="true">{ai.number}</div>
  <div class="inner">
    <div class="head rv">
      <p class="eyebrow eyebrow-accent">{ai.number} &middot; {ai.category} &middot; {ai.org}</p>
      <h2>{ai.title}</h2>
      <p class="summary">{ai.summary}</p>
      <ul class="tags">{ai.tags.map((t) => <li>{t}</li>)}</ul>
    </div>
    <div class="cards">
      {ai.products.map((p, i) => (
        <article class="card rv" style={`transition-delay:${0.08 * (i + 1)}s`}>
          <Visual v={p.visual} class="shot" />
          <h3>{p.name}</h3>
          <p class="tag">{p.tagline}</p>
          <p class="desc">{p.description}</p>
          <p class="meta"><b>Status</b> {p.status}</p>
          <p class="meta"><b>Focus</b> {p.focus.join(' · ')}</p>
          {p.url && <a class="tlink" href={p.url} target="_blank" rel="noopener noreferrer">{p.urlLabel} &rarr;</a>}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head { max-width: 46rem; }
  h2 { font-size: clamp(30px, 3.6vw, 50px); margin: 14px 0 16px; }
  .summary { color: var(--color-muted); margin-bottom: 18px; max-width: 40rem; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 36px; }
  .card :global(.shot), .card :global(.ph) { aspect-ratio: 16 / 9; }
  .card :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; border: 1px solid var(--color-rule); display: block; }
  h3 { font-size: 22px; font-weight: 400; margin: 18px 0 4px; }
  .tag { color: var(--color-muted); font-size: 15px; }
  .desc { margin: 10px 0 10px; font-size: 14px; }
  .meta { font-size: 13px; color: var(--color-muted); margin-bottom: 4px; }
  .meta b { font-weight: 500; color: var(--color-ink); margin-right: 6px; }
  .card .tlink { display: inline-block; margin-top: 10px; font-size: 14px; }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; gap: 24px; } }
</style>
