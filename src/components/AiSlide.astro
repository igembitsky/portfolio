---
import { ai } from '../data/site';
import Visual from './Visual.astro';
const { layout = 'cards' } = Astro.props;
const engineering = [
  'Deterministic matching · LLM evaluation · Claims verification',
  'MCP integration · Agent workflows · Email + Slack',
  '32 patients · 10 languages · Benchmark gates · Source checks',
  'Website · 3D product film · Pilot request flow',
];
const storyLabels = ['How I built it', 'How I built it', 'What I built', 'What I built'];
const stories = [
  [
    { title: 'Why I built it', items: ['I wanted to find roles that fit my experience and ambitions, and prepare high-quality applications.'] },
    { title: 'Engineering decisions', items: ['Deterministic gates and ranking narrow the job pool before LLM evaluation, controlling cost and keeping the matching process inspectable.', 'Claims verification checks the application against the candidate’s experience. Model evaluation and observability help assess consistency and quality.', 'I built and shipped the product with Claude Code, from job discovery through application preparation.'] },
    { title: 'Where it is now', items: ['I use it for my own search and am piloting a boutique service for others.'] },
  ],
  [
    { title: 'Capture and act', items: ['Record my own ideas and guidance alongside user bugs and questions.', 'Triage for later or assign work directly to Claude, Codex, and other MCP-connected agents. Review the results in one shared backlog.'] },
    { title: 'Engineering decisions', items: ['MCP gives Claude, Codex, and other coding agents access to the same backlog and workflow.', 'Local and production projects share the same capture, triage, work, and review process.'] },
    { title: 'Keep people involved', items: ['Reply to users through email and follow issue updates in Slack.', 'The team and its agents can see production issues and the work underway.'] },
    { title: 'Where I use it', items: ['Part of my productivity toolkit across local and production projects.'] },
  ],
  [
    { title: 'What I built', items: ['I designed, built, and shipped all of it with coding agents: the web app, the website, the product video, the analytics, and the test system.', '32 patients set in 11 countries, in ten languages. Each case comes from an openly licensed, published source.', 'It works on a phone, tablet, or computer with nothing to install. A free offline version runs on local, open-source models.'] },
    { title: 'How I check it', items: ['Every case is checked against its published source, so the patient stays true to the clinical facts.', 'Benchmark gates run before each release. They test that the patient follows the case, answers only what was asked, and holds up in each language.', 'I chose the model by benchmark, with a fallback model, cost limits, and misuse guards.', 'I wrote the verification standard: sources, automated tests, real use, then clinician review of a sample.'] },
    { title: 'The video and the website', items: ['I made the product video from real footage of the app, with captions in four languages.', 'The website takes access requests. Privacy-friendly analytics show what people use.'] },
    { title: 'Where it started', items: ['I hosted the AI in medicine plenary at the 2026 Global Health Conference and ran the hands-on workshop. Delegates ran eight patients offline on their own laptops.', 'Partners asked us to keep building it. It is now a pilot with the Global Health Academy.'] },
  ],
  [
    { title: 'What I built', items: ['The full public site: how the product works, installation, how a pilot runs, the FAQ, and the pilot request flow.', 'A 3D product film. Agents modeled the forklift, the hardware, and the warehouse in Blender, then animated and rendered it.'] },
    { title: 'My role', items: ['I lead product at Canary. I wrote the message from what I hear from safety managers.', 'I directed the story and approved each revision.'] },
  ],
];
---
<section class:list={['slide', { editorial: layout === 'editorial' }]} id="build-ai">
  <div class="watermark" aria-hidden="true">{ai.number}</div>
  <div class="inner">
    <div class="head rv">
      <p class="eyebrow eyebrow-accent">04 &middot; Build with AI</p>
      <h2>Products I designed and built with AI.</h2>
    </div>
    <div class="products">
      {ai.products.map((p, i) => (
        <article class="product rv">
          <div class="product-visual"><Visual v={p.visual} /></div>
          <div class="product-copy">
            <h3>{p.name}<span>{p.tagline}</span></h3>
            <p class="description">{p.description}</p>
            <p class="engineering"><span>Engineering</span>{engineering[i]}</p>
            <button class="story-button" data-story-open={`ai-story-${i}`}>{storyLabels[i]}<span aria-hidden="true">↗</span></button>
          </div>
          <footer>
            <span class="status">{p.status}</span>
            <span class="product-links">{p.links.map(l => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}<span aria-hidden="true"> ↗</span></a>)}</span>
          </footer>
        </article>
        <dialog class="story-dialog" id={`ai-story-${i}`} aria-labelledby={`ai-story-title-${i}`}>
          <div class="story-head"><h2 id={`ai-story-title-${i}`}>{p.name}</h2><button class="story-close" aria-label={`Close ${p.name} story`}>Close <span aria-hidden="true">×</span></button></div>
          <div class="story-body">{stories[i].map(chunk => <section><h3>{chunk.title}</h3><ul>{chunk.items.map(item => <li>{item}</li>)}</ul></section>)}</div>
        </dialog>
      ))}
    </div>
  </div>
</section>
<style>
  #build-ai { padding-top: 100px; padding-bottom: 80px; }
  h2 { font-size: clamp(30px, 3.4vw, 46px); margin: 14px 0 0; max-width: 900px; }
  .intro { font-size: 20px; color: var(--color-muted); margin: 14px 0 0; }
  .products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 40px; align-items: stretch; }
  .product { min-width: 0; display: grid; grid-template-rows: auto 1fr auto; background: white; border: 1px solid var(--color-rule); }
  .product-visual { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--color-rule); background: var(--color-ground); }
  .product-visual :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .product-copy { padding: 24px 24px 0; }
  .product-name { display: flex; align-items: baseline; gap: 10px; font-size: 15px; font-weight: 500; margin: 0 0 14px; color: var(--color-accent); }
  .product-name span { font-weight: 400; opacity: .7; }
  h3 { font-size: clamp(24px, 2vw, 28px); line-height: 1.2; font-weight: 500; letter-spacing: -.025em; margin: 0; min-height: 2.4em; text-wrap: balance; }
  .description { color: var(--color-muted); font-size: 18px; line-height: 1.5; margin: 16px 0 22px; min-height: 4.5em; }
  .benefits { list-style: none; padding: 0; margin: 0; font-size: 18px; line-height: 1.45; }
  .benefits li { border-top: 1px solid var(--color-rule); padding: 12px 0; color: var(--color-muted); }
  .benefits strong { font-weight: 500; color: var(--color-ink); }
  details { border-top: 1px solid var(--color-rule); font-size: 16px; }
  summary { min-height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none; color: var(--color-accent); font-weight: 500; }
  summary::-webkit-details-marker { display: none; }
  summary span { font-size: 24px; font-weight: 300; transition: transform .2s; }
  details[open] summary span { transform: rotate(45deg); }
  details p { font-size: 18px; line-height: 1.5; color: var(--color-muted); margin: 0 0 24px; }
  summary:focus-visible, a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  footer { min-height: 84px; align-content: center; border-top: 1px solid var(--color-rule); padding: 16px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; font-size: 15px; }
  .status { color: var(--color-accent); }
  .product-links { display: flex; gap: 16px; }
  a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; display: inline-flex; align-items: center; min-height: 28px; }
  .editorial .products { display: block; }
  .editorial .product { grid-template-columns: 1.15fr 1fr; margin-bottom: 32px; }
  .editorial .product-visual { grid-row: span 2; aspect-ratio: auto; min-height: 440px; border-bottom: 0; border-right: 1px solid var(--color-rule); }
  .editorial .product-copy { padding: 32px 40px 0; }
  .editorial h3 { min-height: 0; font-size: 32px; }
  .editorial .description { min-height: 0; }
  .editorial footer { padding: 16px 40px; }
  .editorial .product:nth-child(even) .product-visual { grid-column: 2; border-right: 0; border-left: 1px solid var(--color-rule); }
  .editorial .product:nth-child(even) .product-copy, .editorial .product:nth-child(even) footer { grid-column: 1; }
  .editorial .product:nth-child(even) .product-copy { grid-row: 1; }
  @media (max-width: 1050px) and (min-width: 761px) {
    .products { gap: 16px; }
    .product-copy { padding: 20px 16px 0; }
    footer { padding: 16px; }
    .description, .benefits { font-size: 16px; }
    .product-name { min-height: 3em; }
  }
  @media (max-width: 760px) {
    #build-ai { padding-top: 64px; padding-bottom: 64px; }
    .intro { font-size: 18px; }
    .products { display: grid; grid-template-columns: 1fr; gap: 32px; margin-top: 28px; }
    .product-name, h3, .description { min-height: 0; }
    h3 { font-size: 28px; }
    .description { margin-bottom: 20px; }
    .product-visual { aspect-ratio: 16 / 9; }
    .editorial .product { display: flex; flex-direction: column; }
    .editorial .product-visual { min-height: 0; aspect-ratio: 16 / 9; border: 0; border-bottom: 1px solid var(--color-rule); }
    .editorial .product-copy { padding: 24px 24px 0; }
    .editorial footer { padding: 16px 24px; }
    a { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) { summary span { transition: none; } }

  .products { margin-top: 28px; }
  .product-copy { padding: 22px 24px 0; display: flex; flex-direction: column; }
  .product-copy h3 { font-size: 22px; min-height: 0; line-height: 1.3; letter-spacing: -.015em; }
  .product-copy h3 span { display: block; font-size: 18px; font-weight: 400; line-height: 1.4; margin-top: 8px; color: var(--color-accent); letter-spacing: 0; }
  .description { min-height: 0; margin: 16px 0; font-size: 18px; }
  .engineering { min-height: 84px; margin: auto 0 16px; padding-top: 14px; color: var(--color-ink); font-size: 15px; line-height: 1.5; }
  .engineering > span { display: block; color: var(--color-muted); font-size: 14px; margin-bottom: 4px; }
  .story-button { border: 0; border-top: 1px solid var(--color-rule); background: none; padding: 12px 0; min-height: 48px; display: flex; justify-content: space-between; align-items: center; gap: 12px; font: inherit; font-size: 16px; color: var(--color-accent); cursor: pointer; margin-top: 0; text-align: left; }
  footer { min-height: 64px; padding: 12px 24px; align-items: center; }
  .story-dialog { position: fixed; inset: 0; width: min(640px, calc(100vw - 32px)); max-width: none; height: fit-content; max-height: calc(100dvh - 48px); margin: auto; padding: 0; border: 1px solid var(--color-rule); background: white; color: var(--color-ink); overflow: hidden; }
  .story-dialog[open] { display: flex; flex-direction: column; }
  .story-dialog::backdrop { background: rgb(23 27 29 / .45); }
  .story-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 28px; border-bottom: 1px solid var(--color-rule); }
  .story-head h2 { font-size: 24px; margin: 0; line-height: 1.2; }
  .story-close { flex-shrink: 0; min-height: 44px; background: none; border: 0; font: inherit; font-size: 16px; color: var(--color-accent); cursor: pointer; }
  .story-close span { margin-left: 8px; font-size: 24px; }
  .story-body { overflow-y: auto; padding: 24px 28px 28px; overscroll-behavior: contain; }
  .story-body section + section { margin-top: 24px; }
  .story-body h3 { font-size: 18px; min-height: 0; margin: 0 0 10px; letter-spacing: 0; line-height: 1.4; }
  .story-body ul { list-style: disc; margin: 0; padding-left: 20px; color: var(--color-muted); font-size: 18px; line-height: 1.5; }
  .story-body li + li { margin-top: 8px; }
  button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  /* Four cards: four columns on wide screens, two by two on medium screens. */
  @media (min-width: 1200px) {
    .engineering { min-height: 108px; }
    footer { min-height: 96px; align-items: flex-start; align-content: flex-start; padding: 16px 24px; }
  }
  @media (max-width: 1199px) and (min-width: 761px) {
    .products { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .product-copy { padding: 22px 24px 0; }
    footer { padding: 12px 24px; }
    .description { font-size: 18px; }
  }
  @media (max-width: 760px) { .story-head { padding: 16px 20px; } .story-body { padding: 20px; } .story-head h2 { font-size: 22px; } }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-story-open]').forEach(button => {
    const dialog = document.getElementById(button.dataset.storyOpen!) as HTMLDialogElement;
    let previousOverflow = '';
    button.addEventListener('click', () => {
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      dialog.querySelector('.story-body')!.scrollTop = 0;
      dialog.querySelector<HTMLButtonElement>('.story-close')!.focus();
    });
    dialog.querySelector('.story-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = previousOverflow;
      button.focus({ preventScroll: true });
    });
  });
</script>
