---
import { ai } from '../data/site';
import Visual from './Visual.astro';
---
<section class="slide" id="build-ai">
  <div class="watermark" aria-hidden="true">{ai.number}</div>
  <div class="inner">
    <div class="head rv">
      <p class="eyebrow eyebrow-accent">{ai.number} &middot; {ai.category} &middot; {ai.org}</p>
      <h2>{ai.title}</h2>
    </div>
    <div class="cards">
      {ai.products.map((p, i) => (
        <article class="card rv" style={`transition-delay:${0.08 * (i + 1)}s`}>
          <div class="frame"><Visual v={p.visual} /></div>
          <h3>{p.name}</h3>
          <p class="tag">{p.tagline}</p>
          <p class="desc">{p.description}</p>
          <ul class="tags">{p.focus.map((t) => <li>{t}</li>)}</ul>
          <p class="meta">{p.status}{p.url && <span> &middot; <a class="tlink" href={p.url} target="_blank" rel="noopener noreferrer">{p.urlLabel} &rarr;</a></span>}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { font-size: clamp(30px, 3.4vw, 46px); margin: 14px 0 0; }
  /* Rows align across the three cards with subgrid: image, name, tagline, description, focus, status */
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: auto auto auto auto auto auto; gap: 0 36px; margin-top: 40px; }
  .card { display: grid; grid-row: span 6; grid-template-rows: subgrid; row-gap: 0; }
  .card :global(img), .card :global(.ph) { aspect-ratio: 16 / 10; }
  h3 { font-size: 24px; font-weight: 500; margin: 20px 0 0; }
  .tag { font-size: var(--fs-body); margin-top: 4px; }
  .desc { margin: 12px 0 0; font-size: var(--fs-body); color: var(--color-muted); }
  .tags { margin-top: 16px; align-self: end; }
  .meta { font-size: var(--fs-small); color: var(--color-muted); margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--color-rule); }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; gap: 28px; } .card { grid-row: auto; grid-template-rows: auto; } }
</style>
