---
import { canary as f } from '../data/spotlight-canary';
import Visual from './Visual.astro';
import Rich from './Rich.astro';
const base = import.meta.env.BASE_URL;
---
<section class="slide flip" id={f.id}>
  <div class="watermark" aria-hidden="true">{f.number}</div>
  <div class="inner grid">
    <div class="text rv">
      <p class="eyebrow eyebrow-accent">{f.number} &middot; {f.category}</p>
      <h2>{f.title}</h2>
      <p class="card-org">{f.org} &middot; {f.role}</p>
      <p class="card-sub">{f.note}</p>
      <ul class="how">{f.how.map((h) => <li><Rich text={h} /></li>)}</ul>
      <button type="button" class="open" data-open={`case-${f.id}`}>View case study &rarr;</button>
    </div>
    <figure class="media rv" style="transition-delay:.12s">
      <div class="frame"><Visual v={f.visual} /></div>
      <figcaption>{f.caption}</figcaption>
    </figure>
  </div>
</section>

<dialog class="case spot" id={`case-${f.id}`} aria-labelledby={`case-${f.id}-title`}>
  <button type="button" class="close" data-close aria-label="Close">Close</button>
  <div class="scroller">
  <div class="heroimg cover"><Visual v={f.hero} /></div>
  <div class="wrap" tabindex="-1">
    <p class="eyebrow eyebrow-accent">{f.org} &middot; {f.role} &middot; Bonsai Technology</p>
    <h2 id={`case-${f.id}-title`} class="plain">{f.caseTitle}</h2>
    <blockquote class="quote"><p>{f.thesis}</p></blockquote>

    <section class="sec"><h3>The starting point</h3><ul class="pts">{f.start.map((p) => <li><Rich text={p} /></li>)}</ul></section>
    <section class="sec"><h3>Who I listened to</h3><p class="lead">The people responsible for preventing accidents on the warehouse floor:</p><ul class="icp">{f.icp.map((i) => <li>{i}</li>)}</ul></section>
    <section class="sec"><h3>What they taught me</h3><ul class="pts">{f.learned.map((p) => <li><Rich text={p} /></li>)}</ul></section>
    <section class="sec"><h3>What I did</h3><ul class="pts">{f.did.map((d) => <li><Rich text={d} /></li>)}</ul></section>
    <section class="sec"><h3>How the product changed</h3>
      <ul class="shift">{f.changed.map((c) => <li><span class="from">{c.before}</span><span class="arrow" aria-hidden="true">&rarr;</span><span class="to">{c.after}</span></li>)}</ul>
    </section>
    <section class="sec"><h3>Gallery</h3>
      <div class="gallery">
        {f.gallery.map((g) => (
          <div class={g.cols === 1 ? 'g1' : g.cols === 2 ? 'g2' : 'g3'}>
            {g.items.map((v) => <div class="frame"><Visual v={v} /><p class="cap">{v.alt}</p></div>)}
          </div>
        ))}
      </div>
    </section>
  </div>
  </div>
</dialog>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; align-items: end; }
  .text .open { align-self: flex-start; }
  .flip .media { order: -1; }
  .flip .text { padding-left: 1vw; }
  h2 { font-size: clamp(28px, 3vw, 40px); margin: 12px 0 10px; max-width: 20ch; }
  .how { list-style: none; padding: 0; margin: 26px 0 0; max-width: 36rem; }
  .how li { position: relative; padding: 12px 0 12px 26px; font-size: var(--fs-body); line-height: 1.5; border-top: 1px solid var(--color-rule); }
  .how li:last-child { border-bottom: 1px solid var(--color-rule); }
  .how li::before { content: ""; position: absolute; left: 0; top: 1.4em; width: 12px; height: 1px; background: var(--color-accent); }
  .how b { font-weight: 500; }
  .media { margin: 0; }
  :global(dialog.spot .heroimg.cover img) { object-fit: cover; object-position: center top; mask-image: linear-gradient(180deg, #000 62%, transparent 100%); -webkit-mask-image: linear-gradient(180deg, #000 62%, transparent 100%); }
  :global(dialog.spot .heroimg.cover) { height: auto; aspect-ratio: 1.9; max-height: 82svh; }
  :global(dialog.spot .heroimg.cover + .wrap) { margin-top: 0; }
  :global(dialog.spot .gallery .g2 .hw img) { aspect-ratio: 3 / 4; object-fit: cover; }
  .media :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; display: block; max-height: 66svh; }
  figcaption { font-size: var(--fs-small); color: var(--color-muted); margin-top: 10px; font-style: italic; }
  .shift { list-style: none; padding: 0; margin: 0; max-width: 52rem; }
  .shift li { display: grid; grid-template-columns: 1fr 24px 1.2fr; gap: 14px; align-items: center; padding: 14px 0; border-top: 1px solid var(--color-rule); font-size: var(--fs-body); }
  .shift li:last-child { border-bottom: 1px solid var(--color-rule); }
  .shift .from { color: var(--color-muted); }
  .shift .arrow { color: var(--color-accent); text-align: center; }
  .shift .to { font-weight: 500; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; gap: 28px; align-items: start; } .media { order: -1; } .shift li { grid-template-columns: 1fr; gap: 4px; } .shift .arrow { display: none; } }
</style>
