---
import { links } from '../data/site';
const items = [
  { label: 'Work', href: '#build-scale' },
  { label: 'About', href: '#about' },
  { label: 'LinkedIn', href: links.linkedin, external: true },
  { label: 'GitHub', href: links.github, external: true, desktop: true },
];
---
<nav class="site-nav" aria-label="Primary">
  <ul>
    {items.map((i) => (
      <li class:list={{ desk: i.desktop }}>
        <a href={i.href} target={i.external ? '_blank' : undefined} rel={i.external ? 'noopener noreferrer' : undefined}>{i.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 30;
    display: flex; justify-content: flex-end; align-items: center;
    padding: 22px 6vw; font-size: var(--fs-small); mix-blend-mode: multiply;
  }
  .site-nav ul { list-style: none; display: flex; gap: 26px; margin: 0; padding: 0; }
  .site-nav a { color: var(--color-muted); transition: color 0.15s; }
  .site-nav a:hover, .site-nav .brand { color: var(--color-ink); }
  .brand { letter-spacing: 0.06em; text-transform: uppercase; font-size: 12px; font-weight: 500; }
  .role { color: var(--color-muted); font-weight: 400; margin-left: 10px; letter-spacing: 0.04em; }
  @media (max-width: 820px) {
    .site-nav { height: 56px; padding: 0 24px; mix-blend-mode: normal; background: rgba(246, 247, 247, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--color-rule); justify-content: center; }
    .site-nav ul { gap: 8px; }
    .site-nav a { display: flex; align-items: center; min-height: 44px; padding: 0 12px; color: var(--color-ink); font-size: var(--fs-body); }
    .site-nav .desk { display: none; }
  }
</style>
