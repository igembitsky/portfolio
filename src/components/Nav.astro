---
import { links, hero } from '../data/site';
const items = [
  { label: 'Work', href: '#build-scale' },
  { label: 'About', href: '#about' },
  { label: 'LinkedIn', href: links.linkedin, external: true },
  { label: 'GitHub', href: links.github, external: true },
];
---
<nav class="site-nav" aria-label="Primary">
  <a class="brand" href="#top">Igor Gembitsky <span class="role">{hero.eyebrow}</span></a>
  <ul>
    {items.map((i) => (
      <li>
        <a href={i.href} target={i.external ? '_blank' : undefined} rel={i.external ? 'noopener noreferrer' : undefined}>{i.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 30;
    display: flex; justify-content: space-between; align-items: center;
    padding: 22px 6vw; font-size: 14px; mix-blend-mode: multiply;
  }
  .site-nav ul { list-style: none; display: flex; gap: 26px; margin: 0; padding: 0; }
  .site-nav a { color: var(--color-muted); transition: color 0.15s; }
  .site-nav a:hover, .site-nav .brand { color: var(--color-ink); }
  .brand { letter-spacing: 0.06em; text-transform: uppercase; font-size: 12px; font-weight: 500; }
  .role { color: var(--color-muted); font-weight: 400; margin-left: 10px; letter-spacing: 0.04em; }
  @media (max-width: 820px) { .site-nav { padding: 18px 24px; } .site-nav ul { gap: 16px; } .role { display: none; } }
</style>
