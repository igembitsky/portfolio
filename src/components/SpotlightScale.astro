---
import { scale as f } from '../data/spotlight-scale';
import Visual from './Visual.astro';
import Rich from './Rich.astro';
import LifecycleDiagram from './LifecycleDiagram.astro';
---
<section class="slide" id={f.id}>
  <div class="watermark" aria-hidden="true">{f.number}</div>
  <div class="inner grid">
    <div class="head rv">
      <p class="eyebrow eyebrow-accent">{f.number}&nbsp;&middot; {f.category}</p>
      <h2>{f.title}</h2>
      <p class="card-org">{f.org}&nbsp;&middot; {f.role}</p>
      <p class="card-sub">{f.note}</p>
    </div>
    <div class="body rv" style="transition-delay:.08s">
      <div class="score" role="table" aria-label="Impact scorecard">
        <div class="shead"><span class="stitle">Impact scorecard</span><span class="speriod">2021 to 2024</span></div>
        <div class="scols" role="row"><span></span><span>Before</span><span></span><span class="after">After</span></div>
        {f.compare.map((r) => (
          <div class="srow" role="row">
            <span class="slab" role="cell">{r.label}</span>
            <span class="sbefore" role="cell">{r.before}</span>
            <span class="sarrow" aria-hidden="true">&rarr;</span>
            <span class="safter" role="cell">{r.after} {r.delta && <span class="sdelta">{r.delta}</span>}</span>
          </div>
        ))}
      </div>
      <button type="button" class="open" data-open={`case-${f.id}`}>View case study &rarr;</button>
    </div>
    <div class="media frame rv diagram-box" style="transition-delay:.12s">
      <LifecycleDiagram />
      <ol class="lifelist" aria-label="Customer lifecycle">
        {[
          ['Sales', 'Signed SOW', '#3b72cc'],
          ['Implementation', 'Live customer', '#4ca191'],
          ['Adoption', 'App utilization', '#804195'],
          ['Use & Success', 'Business value', '#d31c50'],
          ['Relationship', 'Renewals and referrals', '#713782'],
        ].map(([n, sub, c], i, all) => <li style={`--c:${c};--n:${all[(i + 1) % all.length][2]}`}><b>{n}</b><span>{sub}</span></li>)}
      </ol>
    </div>
  </div>
</section>

<dialog class="case spot" id={`case-${f.id}`} aria-labelledby={`case-${f.id}-title`}>
  <button type="button" class="close" data-close aria-label="Close">Close</button>
  <div class="bar" aria-hidden="true">{f.org}</div>
  <div class="scroller" tabindex="-1">
  <div class="heroimg product"><Visual v={f.hero} /></div>
  <div class="wrap" tabindex="-1">
    <p class="eyebrow eyebrow-accent"><span class="org">{f.org}&nbsp;&middot; </span>{f.role}</p>
    <h2 id={`case-${f.id}-title`} class="plain">{f.caseTitle}</h2>
    <blockquote class="quote"><p>{f.thesis}</p><ul class="wins">{f.wins.map((w) => <li>{w}</li>)}</ul></blockquote>

    <section class="sec"><h3>Where the company was</h3><ul class="pts">{f.where.map((p) => <li><Rich text={p} /></li>)}</ul></section>
    <section class="sec"><h3>The problem</h3><ul class="pts">{f.problem.map((p) => <li><Rich text={p} /></li>)}</ul></section>
    <section class="sec"><h3>Who it is for</h3><p class="lead">Everyone between a signed contract and a renewed one:</p><ul class="icp">{f.icp.map((i) => <li>{i}</li>)}</ul></section>
    <section class="sec"><h3>What I did</h3><ul class="pts">{f.did.map((d) => <li><Rich text={d} /></li>)}</ul></section>
    <section class="sec"><h3>Impact</h3><div class="impact6">{f.impact.map((m) => <div><b>{m.value}</b><span>{m.label}</span></div>)}</div></section>
    <section class="sec"><h3>Gallery</h3><p class="lead">{f.visualsNote}</p>
      <div class="gallery">
        {f.gallery.map((g) => (
          <div class={g.cols === 1 ? 'g1' : g.cols === 2 ? 'g2' : 'g3 wide'}>
            {g.items.map((v) => <div class="frame"><Visual v={v} /><p class="cap">{v.alt}</p></div>)}
          </div>
        ))}
      </div>
    </section>
    <button type="button" class="btn back" data-close>Back to the work</button>
  </div>
  </div>
</dialog>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr auto; grid-template-areas: "head media" "body media"; gap: 0 5vw; align-items: end; }
  .head { grid-area: head; } .body { grid-area: body; display: flex; flex-direction: column; } .media { grid-area: media; }
  .body .open { align-self: flex-start; }
  .lifelist { display: none; }
  h2 { font-size: clamp(28px, 3vw, 40px); margin: 12px 0 10px; max-width: 20ch; }
  .diagram-box { width: 100%; aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; padding: 1% 1.5%; }
  :global(dialog.spot .heroimg.product) { height: auto; max-width: 84rem; margin: 0 auto; padding: 72px 3vw 0; overflow: visible; }
  :global(dialog.spot .heroimg.product img) { height: auto; object-fit: contain; -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%); mask-image: linear-gradient(180deg, #000 70%, transparent 100%); }
  :global(dialog.spot .heroimg.product + .wrap) { margin-top: -3vh; }
  .wins { list-style: none; padding: 0; margin: 22px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 28px; }
  .wins li { position: relative; padding-left: 24px; font-size: var(--fs-lead); font-weight: 500; line-height: 1.3; }
  .wins li::before { content: ""; position: absolute; left: 0; top: 0.8em; width: 12px; height: 1px; background: var(--color-accent); }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; grid-template-rows: auto; grid-template-areas: "head" "media" "body"; gap: 24px; align-items: start; }
    .diagram-box { aspect-ratio: auto; display: block; padding: 6px 20px; }
    .diagram-box :global(svg) { display: none; }
    /* Phone version of the loop: a vertical flow. Rows are equal height and each node sits level with its stage name (--y from the row top), so the dashed return path can run from the last node back to the first. */
    .lifelist { --y: 25px; display: grid; grid-auto-rows: 1fr; position: relative; list-style: none; margin: 0; padding: 6px 0 6px 26px; }
    .lifelist li { position: relative; display: grid; grid-template-columns: 22px 1fr; column-gap: 16px; align-content: start; padding: 14px 0; }
    .lifelist li > * { grid-column: 2; }
    .lifelist li::before { content: ""; grid-column: 1; grid-row: 1; align-self: center; justify-self: center; position: relative; z-index: 1; width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 3px solid var(--c); box-shadow: 0 0 0 4px #fff; }
    .lifelist li:not(:last-child)::after { content: ""; position: absolute; left: 10px; top: var(--y); height: 100%; width: 2px; background: linear-gradient(var(--c), var(--n)); }
    .lifelist b { font-weight: 500; font-size: var(--fs-body); line-height: 1.25; }
    .lifelist span { justify-self: start; margin-top: 6px; padding: 3px 10px; border-radius: 999px; font-size: var(--fs-small); line-height: 1.35; color: var(--color-ink); background: color-mix(in srgb, var(--c) 11%, #fff); }
    .lifelist::before { content: ""; position: absolute; left: 4px; width: 18px; top: calc(6px + var(--y)); bottom: calc(6px + (100% - 12px) * 0.2 - var(--y)); border: 1.5px dashed var(--color-muted); border-right: 0; border-radius: 18px 0 0 18px; opacity: 0.55; }
    .lifelist::after { content: ""; position: absolute; left: 21px; top: calc(6px + var(--y)); transform: translateY(-50%); border: 5px solid transparent; border-left: 8px solid var(--color-muted); border-right-width: 0; }
    .wins { grid-template-columns: 1fr; }
  }
</style>
