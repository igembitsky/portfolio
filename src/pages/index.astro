---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Dots from '../components/Dots.astro';
import Hero from '../components/Hero.astro';
import FlagshipSlide from '../components/FlagshipSlide.astro';
import AiSlide from '../components/AiSlide.astro';
import OthersSlide from '../components/OthersSlide.astro';
import AboutSlide from '../components/AboutSlide.astro';
import { flagships } from '../data/site';
---
<BaseLayout>
  <Nav />
  <Dots />
  <main>
    <Hero />
    <div class="work-anchor" id="work"></div>
    {flagships.map((f) => <FlagshipSlide f={f} />)}
    <AiSlide />
    <OthersSlide />
    <AboutSlide />
  </main>
</BaseLayout>

<script>
  document.documentElement.classList.add('js');

  // Reveal on entry
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }
  }, { threshold: 0.18 });
  document.querySelectorAll<HTMLElement>('.rv').forEach((el) => {
    if (el.getBoundingClientRect().top < innerHeight * 0.9) el.classList.add('in');
    else io.observe(el);
  });

  // Progress dots
  const dots = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-dot]').forEach((a) => dots.set(a.dataset.dot!, a));
  const so = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        dots.forEach((a) => a.removeAttribute('aria-current'));
        dots.get((e.target as HTMLElement).id)?.setAttribute('aria-current', 'true');
      }
    }
  }, { threshold: 0.55 });
  document.querySelectorAll<HTMLElement>('section.slide[id]').forEach((s) => so.observe(s));

  // Case study dialogs
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const d = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      if (!d) return;
      d.showModal();
      d.scrollTop = 0;
      document.documentElement.style.overflow = 'hidden';
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.case').forEach((d) => {
    d.querySelector('[data-close]')?.addEventListener('click', () => d.close());
    d.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
    d.addEventListener('click', (ev) => { if (ev.target === d) d.close(); });
  });
</script>

<style>
  .work-anchor { position: relative; top: 0; height: 0; }
</style>
