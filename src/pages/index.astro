---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Dots from '../components/Dots.astro';
import Hero from '../components/Hero.astro';
import SpotlightSlide from '../components/SpotlightSlide.astro';
import SpotlightCanary from '../components/SpotlightCanary.astro';
import SpotlightScale from '../components/SpotlightScale.astro';
import AiSlide from '../components/AiSlide.astro';
import OthersSlide from '../components/OthersSlide.astro';
import AboutSlide from '../components/AboutSlide.astro';
---
<BaseLayout>
  <Nav />
  <Dots />
  <main>
    <Hero />
    <div class="work-anchor" id="work"></div>
    <SpotlightSlide />
    <SpotlightCanary />
    <SpotlightScale />
    <AiSlide />
    <OthersSlide />
    <AboutSlide />
  </main>
</BaseLayout>

<script>
  document.documentElement.classList.add('js');

  // Reveal on entry
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }
  }, { threshold: 0.18 });
  document.querySelectorAll<HTMLElement>('.rv').forEach((el) => {
    if (el.getBoundingClientRect().top < innerHeight * 0.9) el.classList.add('in');
    else io.observe(el);
  });

  // Progress dots
  const dots = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-dot]').forEach((a) => dots.set(a.dataset.dot!, a));
  const so = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        dots.forEach((a) => a.removeAttribute('aria-current'));
        dots.get((e.target as HTMLElement).id)?.setAttribute('aria-current', 'true');
      }
    }
  }, { threshold: 0.55 });
  document.querySelectorAll<HTMLElement>('section.slide[id]').forEach((s) => so.observe(s));

  // Case study dialogs: a burst grows from the button, the panel fades in, and the whole thing reverses on close
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const burst = document.createElement('div'); burst.className = 'burst'; document.body.appendChild(burst);
  const coverScale = (x: number, y: number) => {
    const dx = Math.max(x, innerWidth - x), dy = Math.max(y, innerHeight - y);
    return (Math.hypot(dx, dy) * 2) / 40 + 1;
  };
  let lastTrigger: HTMLElement | null = null;
  const placeBurst = (el: HTMLElement) => {
    const r = el.getBoundingClientRect();
    const x = r.left + r.width / 2, y = r.top + r.height / 2;
    burst.style.left = `${x}px`; burst.style.top = `${y}px`;
    return coverScale(x, y);
  };
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const d = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      if (!d) return;
      lastTrigger = btn;
      d.classList.remove('closing');
      document.documentElement.style.overflow = 'hidden';
      if (!reduced) {
        const sc = placeBurst(btn);
        const a = burst.animate(
          [{ transform: 'translate(-50%, -50%) scale(0)' }, { transform: `translate(-50%, -50%) scale(${sc})` }],
          { duration: 480, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }
        );
        await a.finished;
        d.showModal(); d.scrollTop = 0; (d.querySelector('.wrap') as HTMLElement | null)?.focus({ preventScroll: true });
        burst.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 350, delay: 150, fill: 'forwards' }).finished.then(() => {
          burst.getAnimations().forEach((an) => an.cancel());
        });
      } else {
        d.showModal(); d.scrollTop = 0; (d.querySelector('.wrap') as HTMLElement | null)?.focus({ preventScroll: true });
      }
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.case').forEach((d) => {
    const closeSoft = async () => {
      if (d.classList.contains('closing')) return;
      d.classList.add('closing');
      if (!reduced && lastTrigger) {
        const sc = placeBurst(lastTrigger);
        burst.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200, fill: 'forwards' });
        const a = burst.animate(
          [{ transform: `translate(-50%, -50%) scale(${sc})` }, { transform: 'translate(-50%, -50%) scale(0)' }],
          { duration: 520, delay: 180, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }
        );
        setTimeout(() => { d.classList.remove('closing'); d.close(); }, 380);
        await a.finished;
        burst.getAnimations().forEach((an) => an.cancel());
      } else {
        d.classList.remove('closing'); d.close();
      }
    };
    d.querySelector('[data-close]')?.addEventListener('click', closeSoft);
    d.addEventListener('cancel', (ev) => { ev.preventDefault(); closeSoft(); });
    d.addEventListener('click', (ev) => { if (ev.target === d) closeSoft(); });
    d.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
  });
</script>

<style>
  .work-anchor { position: relative; top: 0; height: 0; }
</style>
