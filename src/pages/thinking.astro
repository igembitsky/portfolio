---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about, links } from '../data/site';
import { values, thesis, pillars, stages, books, goodreads, podcasts, toolbox } from '../data/thinking';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<BaseLayout title="How I think, Igor Gembitsky" description="Values, method, books, podcasts, tools, and published research.">
  <nav class="site-nav" aria-label="Primary">
    <a class="back" href={base}>&larr; Back to the work</a>
    <ul>
      <li><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
    </ul>
  </nav>

  <main class="page">
    <header class="top">
      <p class="eyebrow eyebrow-accent">A little deeper</p>
      <h1>How I think</h1>
      <p class="lead">For anyone who wants to dig past the case studies. What I value, how I work, what I read and listen to, what I use, and what I published.</p>
    </header>

    <section class="block">
      <h2>What I value</h2>
      <p class="lead muted">My definition of good.</p>
      <ul class="values">
        {values.map((v) => <li><b>{v.name}</b><span>{v.line}</span></li>)}
      </ul>
    </section>

    <section class="block">
      <h2>How I think</h2>
      <blockquote class="quote"><p><a href={thesis.source} target="_blank" rel="noopener noreferrer">{thesis.quote}</a></p></blockquote>
      <p class="lead">{thesis.line}</p>
      <ul class="pillars">
        {pillars.map((p) => <li><b>{p.name}</b><span>{p.line}</span></li>)}
      </ul>
      <h3>How I do the work</h3>
      <ol class="stages">
        {stages.map((s) => <li><span class="n">{s.n}</span><b>{s.name}.</b><span class="tools">{s.tools.join(' · ')}</span></li>)}
      </ol>
    </section>

    <section class="block">
      <h2>Books that shaped how I work</h2>
      <ul class="covers">
        {books.map((b) => <li><a href={b.url} target="_blank" rel="noopener noreferrer" title={`${b.title} by ${b.author}`}><img src={`${base}${b.img}`} alt={`${b.title} by ${b.author}`} loading="lazy" /><span>{b.title}</span><small>{b.author}</small></a></li>)}
      </ul>
      <p class="more"><a class="tlink" href={goodreads} target="_blank" rel="noopener noreferrer">More on Goodreads &rarr;</a></p>
    </section>

    <section class="block">
      <h2>Podcasts that inspire my thinking</h2>
      <ul class="covers square">
        {podcasts.map((p) => <li><a href={p.url} target="_blank" rel="noopener noreferrer" title={`${p.title}, ${p.by}`}><img src={`${base}${p.img}`} alt={p.title} loading="lazy" /><span>{p.title}</span><small>{p.by}</small></a></li>)}
      </ul>
    </section>

    <section class="block">
      <h2>Toolbox</h2>
      <div class="tools">
        {toolbox.map((g) => (
          <div class="group">
            <p class="eyebrow">{g.group}</p>
            <ul>{g.tools.map((t) => <li><img src={`${base}${t.img}`} alt="" loading="lazy" /><span>{t.name}</span></li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="block" id="papers">
      <h2>Peer-reviewed research</h2>
      <p class="lead muted">Three papers from my years in biochemistry and neuroscience research.</p>
      <ol class="papers">
        {about.papers.map((p, i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <div><a href={p.url} target="_blank" rel="noopener noreferrer">{p.title} &rarr;</a><p class="meta">{p.journal} &middot; {p.date}</p></div>
          </li>
        ))}
      </ol>
      <h3>The scientific discipline translated remarkably well to building good products</h3>
      <ul class="method">{about.method.map((m) => <li>{m}</li>)}</ul>
    </section>

    <footer class="foot">
      <a class="tlink" href={base}>&larr; Back to the work</a>
      <span>&copy; {year} Igor Gembitsky</span>
    </footer>
  </main>
</BaseLayout>

<style is:global>
  html { scroll-snap-type: none !important; }
</style>

<style>
  .site-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 30; display: flex; justify-content: space-between; align-items: center; padding: 22px 6vw; font-size: var(--fs-small); background: rgba(246,247,247,0.85); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .site-nav ul { list-style: none; display: flex; gap: 26px; margin: 0; padding: 0; }
  .site-nav a { color: var(--color-muted); transition: color 0.15s; } .site-nav a:hover { color: var(--color-ink); }
  .back { color: var(--color-ink) !important; }
  .page { width: min(64rem, 100%); margin: 0 auto; padding: 140px 6vw 96px; }
  .top h1 { font-size: clamp(38px, 5vw, 64px); margin: 12px 0 18px; }
  .lead { font-size: var(--fs-lead); max-width: 40rem; }
  .muted { color: var(--color-muted); }
  .block { padding: 72px 0 0; }
  .block h2 { font-size: clamp(28px, 3.2vw, 40px); margin: 0 0 14px; }
  .block h3 { font-size: var(--fs-lead); font-weight: 500; margin: 44px 0 14px; color: var(--color-accent); }

  .values { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px 40px; }
  .values li { border-top: 1px solid var(--color-rule); padding-top: 14px; }
  .values b { display: block; font-size: var(--fs-lead); font-weight: 500; margin-bottom: 6px; }
  .values span { color: var(--color-muted); font-size: var(--fs-body); }

  .quote { margin: 24px 0 18px; padding: 24px 30px; border-left: 3px solid var(--color-accent); background: rgba(47, 93, 98, 0.05); max-width: 40rem; }
  .quote p { margin: 0; font-size: clamp(26px, 2.6vw, 36px); font-weight: 300; line-height: 1.3; }
  .quote a { color: inherit; border-bottom: 1px solid var(--color-accent); }
  .pillars { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 32px; }
  .pillars li { border-top: 1px solid var(--color-rule); padding-top: 14px; }
  .pillars b { display: block; font-weight: 500; color: var(--color-accent); margin-bottom: 6px; }
  .pillars span { font-size: var(--fs-body); }
  .stages { list-style: none; padding: 0; margin: 0; }
  .stages li { display: grid; grid-template-columns: 56px 1fr; gap: 4px 12px; padding: 14px 0; border-top: 1px solid var(--color-rule); align-items: baseline; }
  .stages .n { color: var(--color-accent); font-size: var(--fs-small); }
  .stages b { font-weight: 500; font-size: var(--fs-lead); }
  .stages .tools { grid-column: 2; color: var(--color-muted); font-size: var(--fs-body); }

  .covers { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 24px 20px; }
  .covers li a { display: block; color: inherit; }
  .covers img { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; display: block; border: 1px solid var(--color-rule); background: #fff; transition: transform 0.25s; }
  .covers.square img { aspect-ratio: 1; }
  .covers li a:hover img { transform: translateY(-4px); }
  .covers span { display: block; margin-top: 10px; font-size: var(--fs-small); font-weight: 500; line-height: 1.3; }
  .covers small { display: block; font-size: var(--fs-small); color: var(--color-muted); }
  .covers.square { grid-template-columns: repeat(5, 1fr); }
  .more { margin-top: 24px; font-size: var(--fs-body); }

  .tools { display: grid; gap: 28px; margin-top: 24px; }
  .group ul { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 10px 12px; }
  .group li { display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--color-rule); background: #fff; border-radius: 999px; padding: 8px 14px 8px 10px; font-size: var(--fs-small); }
  .group img { width: 20px; height: 20px; object-fit: contain; }

  .papers { list-style: none; padding: 0; margin: 28px 0 0; max-width: 52rem; }
  .papers li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; padding: 22px 0; border-top: 1px solid var(--color-rule); }
  .papers .n { color: var(--color-accent); font-size: var(--fs-small); padding-top: 6px; }
  .papers a { font-size: clamp(18px, 1.6vw, 24px); line-height: 1.3; border-bottom: 1px solid var(--color-accent); }
  .papers a:hover { color: var(--color-accent); }
  .papers .meta { color: var(--color-muted); font-size: var(--fs-small); margin-top: 8px; }
  .method { list-style: none; padding: 0; margin: 0; max-width: 44rem; }
  .method li { position: relative; padding: 8px 0 8px 24px; font-size: var(--fs-body); border-top: 1px solid var(--color-rule); }
  .method li:first-child { border-top: 0; }
  .method li::before { content: ""; position: absolute; left: 0; top: 1.25em; width: 10px; height: 1px; background: var(--color-accent); }

  .foot { display: flex; justify-content: space-between; gap: 20px; margin-top: 96px; padding-top: 24px; border-top: 1px solid var(--color-rule); font-size: var(--fs-small); color: var(--color-muted); }

  @media (max-width: 820px) {
    .site-nav { padding: 14px 24px; }
    .page { padding: 110px 24px 64px; }
    .values, .pillars { grid-template-columns: 1fr; }
    .covers { grid-template-columns: repeat(3, 1fr); gap: 20px 14px; }
    .covers.square { grid-template-columns: repeat(3, 1fr); }
    .foot { flex-direction: column; }
  }
</style>
